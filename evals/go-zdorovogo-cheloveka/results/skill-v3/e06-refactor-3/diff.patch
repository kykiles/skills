+
+// formatLevelSection выводит секцию отчёта для заданного уровня.
+// showMessages указывает, выводить ли уникальные сообщения или только их количество.
+func formatLevelSection(b *strings.Builder, level Level, entries map[string][]Entry, showMessages bool) {
+	b.WriteString("\n[" + level.String() + "]\n")
+
+	var sources []string
+	for s := range entries {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		var msgs []string
+		seen := map[string]bool{}
+		for _, e := range entries[s] {
+			n += e.Count
+			if !seen[e.Message] {
+				seen[e.Message] = true
+				if showMessages {
+					msgs = append(msgs, e.Message)
+				}
+			}
+		}
+		total += n
+
+		var msgPart string
+		if showMessages {
+			msgPart = strings.Join(msgs, "; ")
+		} else {
+			msgPart = fmt.Sprintf("(%d сообщ.)", len(seen))
+		}
+		b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, msgPart))
+	}
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+}
