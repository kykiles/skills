+
+// TestLoadNotExist проверяет, что при отсутствии файла
+// возвращается ошибка, которую можно проверить через errors.Is
+func TestLoadNotExist(t *testing.T) {
+	cfg, err := Load("/nonexistent/path/config.json")
+
+	// Проверяем, что ошибка не nil
+	if err == nil {
+		t.Fatalf("Load() returned nil error for nonexistent file, want error")
+	}
+
+	// Проверяем, что cfg == nil при ошибке (не typed nil)
+	if cfg != nil {
+		t.Fatalf("Load() returned non-nil config for nonexistent file, want nil")
+	}
+
+	// Проверяем, что можем перехватить fs.ErrNotExist
+	if !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("Load() error is not fs.ErrNotExist: %v", err)
+	}
+}
+
+// TestLoadValid проверяет, что при корректном файле
+// возвращается nil ошибка
+func TestLoadValid(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	// Минимально корректный конфиг
+	data := []byte(`{"port": 8080}`)
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	cfg, err := Load(path)
+
+	// На успех err должен быть nil (не typed nil)
+	if err != nil {
+		t.Fatalf("Load() returned error for valid config: %v", err)
+	}
+
+	// cfg не должен быть nil на успех
+	if cfg == nil {
+		t.Fatalf("Load() returned nil config on success, want config")
+	}
+
+	// Проверяем значения
+	if cfg.Port != 8080 {
+		t.Fatalf("Port = %d, want 8080", cfg.Port)
+	}
+	if cfg.Addr != "127.0.0.1" {
+		t.Fatalf("Addr = %s, want 127.0.0.1", cfg.Addr)
+	}
+	if cfg.LogLevel != "info" {
+		t.Fatalf("LogLevel = %s, want info", cfg.LogLevel)
+	}
+}
