+// TestGetStatusNotFound проверяет, что GetStatus возвращает ErrNotFound для 404.
+func TestGetStatusNotFound(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte(`{"error":"not found"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(context.Background(), "nonexistent")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("GetStatus for 404 returned err=%v, want ErrNotFound", err)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus for 404 returned non-zero Status: %+v", st)
+	}
+}
+
+// TestGetStatusError проверяет, что GetStatus возвращает StatusError для других статусов.
+func TestGetStatusError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte(`{"error":"server error"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(context.Background(), "42")
+	var statusErr *StatusError
+	if !errors.As(err, &statusErr) {
+		t.Fatalf("GetStatus for 500 returned err=%v, want *StatusError", err)
+	}
+	if statusErr.Code != http.StatusInternalServerError {
+		t.Fatalf("StatusError.Code = %d, want %d", statusErr.Code, http.StatusInternalServerError)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus for 500 returned non-zero Status: %+v", st)
+	}
+}
+
+// TestGetStatusCancellation проверяет, что GetStatus реагирует на отмену контекста.
+func TestGetStatusCancellation(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Имитируем долгую работу: сервер не отправляет ответ до истечения времени
+		time.Sleep(2 * time.Second)
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(ctx, "42")
+	if err == nil {
+		t.Fatal("GetStatus with cancelled context should return error")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("GetStatus returned err=%v, want context.DeadlineExceeded", err)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus for cancelled context returned non-zero Status: %+v", st)
+	}
+}
