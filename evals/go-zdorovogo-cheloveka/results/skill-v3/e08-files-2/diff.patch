 		t.Fatalf("CountMatches = %v; want 2", got)
 	}
 }
+
+// TestCountMatchesManyFiles проверяет, что функция корректно закрывает файлы
+// и не падает с "too many open files" на большом количестве файлов.
+func TestCountMatchesManyFiles(t *testing.T) {
+	dir := t.TempDir()
+	const numFiles = 100
+	paths := make([]string, numFiles)
+
+	// Создаём множество файлов
+	for i := 0; i < numFiles; i++ {
+		p := filepath.Join(dir, fmt.Sprintf("log_%d.log", i))
+		paths[i] = p
+		// Каждый файл содержит несколько совпадений
+		content := "match\nmatch\nok\nmatch\n"
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	got, err := CountMatches(paths, "match")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	// Каждый файл должен содержать 3 совпадения
+	for _, p := range paths {
+		if got[p] != 3 {
+			t.Errorf("CountMatches[%s] = %d; want 3", p, got[p])
+		}
+	}
+}
+
+// TestCountMatchesLongLines проверяет, что функция корректно обрабатывает
+// строки длиннее стандартного буфера bufio.Scanner.
+func TestCountMatchesLongLines(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "long.log")
+
+	// Создаём файл с очень длинной строкой (100 КиБ)
+	longLine := strings.Repeat("x", 100*1024) + "match"
+	content := "short\n" + longLine + "\nshort\nmatch\n"
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := CountMatches([]string{p}, "match")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	// Должны найти оба совпадения
+	if got[p] != 2 {
+		t.Fatalf("CountMatches = %d; want 2", got[p])
+	}
+}
