+// countFileMatches закрывает файл до перехода к следующему и проверяет ошибки сканирования.
+func countFileMatches(path string, needle string) (int, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0, err
+	}
+	defer f.Close()
+
+	n := 0
+	sc := bufio.NewScanner(f)
+	// Используем большой буфер для строк, которые длиннее стандартных 64 КиБ.
+	buf := make([]byte, 0, 64*1024)
+	sc.Buffer(buf, 10*1024*1024) // Max 10 МиБ для одной строки
+	for sc.Scan() {
+		if strings.Contains(sc.Text(), needle) {
+			n++
+		}
+	}
+	if err := sc.Err(); err != nil {
+		return 0, err
+	}
+	return n, nil
+}
