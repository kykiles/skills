+func TestProcessAllError(t *testing.T) {
+	items := []string{"a", "bb", "ccc"}
+	errExpected := errors.New("test error")
+	var callCount atomic.Int32
+
+	got, err := ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		callCount.Add(1)
+		if s == "bb" {
+			return 0, errExpected
+		}
+		return len(s), nil
+	})
+
+	if err != errExpected {
+		t.Fatalf("expected error %v, got %v", errExpected, err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil result on error, got %v", got)
+	}
+
+	// Проверяем, что функция гарантирует завершение всех горутин
+	// путём вызова wg.Wait()
+	// Если горутины не завершились, тест зависнет
