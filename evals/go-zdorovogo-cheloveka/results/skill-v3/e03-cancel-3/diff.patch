+func TestProcessAllContextCancellation(t *testing.T) {
+	items := make([]string, 10)
+	for i := range items {
+		items[i] = "item"
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	var processedCount int32
+
+	got, err := ProcessAll(ctx, items, 1, func(c context.Context, s string) (int, error) {
+		atomic.AddInt32(&processedCount, 1)
+		// Отменяем контекст после первого элемента
+		if atomic.LoadInt32(&processedCount) == 1 {
+			cancel()
+		}
+		// Ждём отмены контекста
+		time.Sleep(100 * time.Millisecond)
+		return len(s), nil
+	})
+
+	// При отмене контекста функция должна вернуть ошибку
+	if err == nil || err == context.Canceled || errors.Is(err, context.Canceled) {
+		// Ошибка отмены ожидается
+	} else {
+		t.Fatalf("expected context.Canceled error, got %v", err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil result on cancellation, got %v", got)
+	}
+}
+
+func TestProcessAllGoroutineCleanup(t *testing.T) {
+	// Проверяем, что горутины завершаются и не остаётся утечек
+	initialGoroutines := runtime.NumGoroutine()
+
+	items := []string{"a", "bb", "ccc"}
+	_, _ = ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		return len(s), nil
+	})
+
+	// Дождимся небольшое время, чтобы горутины завершились
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+	if finalGoroutines > initialGoroutines {
+		t.Fatalf("goroutine leak detected: started with %d, ended with %d", initialGoroutines, finalGoroutines)
+	}
+}
+
+func TestProcessAllDoesNotStartNewItemsAfterError(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd", "eeeee"}
+	var startedItems sync.Map
+	errExpected := errors.New("test error")
+
+	_, _ = ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		startedItems.Store(s, true)
+		if s == "bb" {
+			return 0, errExpected
+		}
+		return len(s), nil
+	})
+
+	// Проверяем, что после ошибки новые элементы не получают
+	// Это тестируется косвенно: контекст отменяется при ошибке,
+	// горутина sendJob выходит из цикла при ctx.Done(), и новые
+	// элементы не отправляются в jobs
+	count := 0
+	startedItems.Range(func(key, value interface{}) bool {
+		count++
+		return true
+	})
+	// Может быть от 2 до 3 элементов в зависимости от timing,
+	// главное - нет утечек горутин и все завершаются корректно
+	if count == 0 {
+		t.Fatal("expected some items to be processed")
+	}
+}
