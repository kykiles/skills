+// TestGetStatusNotFound проверяет, что на 404 возвращается ErrNotFound.
+func TestGetStatusNotFound(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte(`{"error":"not found"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(context.Background(), "notexist")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("GetStatus(notexist) = %v, want ErrNotFound", err)
+	}
+}
+
+// TestGetStatusError проверяет, что на непредвиденный статус возвращается StatusError.
+func TestGetStatusError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte(`{"error":"server error"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(context.Background(), "42")
+	var se *StatusError
+	if !errors.As(err, &se) || se.Code != http.StatusInternalServerError {
+		t.Fatalf("GetStatus = %v, want StatusError with code 500", err)
+	}
+}
+
+// TestGetStatusContextCancel проверяет, что GetStatus реагирует на отмену контекста.
+func TestGetStatusContextCancel(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(100 * time.Millisecond)
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(ctx, "42")
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("GetStatus with cancelled context = %v, want context.DeadlineExceeded", err)
+	}
+}
+
+// TestGetStatusConnectionReuse проверяет, что Body закрывается и соединения переиспользуются.
+// Это косвенный тест — если Body не закрывается, соединения копятся.
+func TestGetStatusConnectionReuse(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.RequestURI == "/v1/status/ok" {
+			w.Write([]byte(`{"id":"ok","state":"done"}`))
+		} else {
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+
+	// Делаем несколько запросов: успешный, 404 и т.д. Если Body не закрывается,
+	// соединения останутся открытыми (в тесте это видно через логи сервера).
+	st, err := c.GetStatus(context.Background(), "ok")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.ID != "ok" {
+		t.Fatalf("first request: GetStatus = %+v", st)
+	}
+
+	_, err = c.GetStatus(context.Background(), "notexist")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("second request (404): GetStatus = %v, want ErrNotFound", err)
+	}
+
+	// Третий запрос должен пройти успешно — соединения должны быть переиспользованы.
+	st, err = c.GetStatus(context.Background(), "ok")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st.ID != "ok" {
+		t.Fatalf("third request: GetStatus = %+v", st)
+	}
+}
