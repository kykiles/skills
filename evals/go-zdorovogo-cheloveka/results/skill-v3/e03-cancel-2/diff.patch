+
+func TestProcessAllError(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd"}
+	var started int32
+	testErr := errors.New("test error")
+
+	got, err := ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		atomic.AddInt32(&started, 1)
+		if s == "ccc" {
+			return 0, testErr
+		}
+		return len(s), nil
+	})
+
+	if !errors.Is(err, testErr) {
+		t.Fatalf("expected test error, got %v", err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil result on error, got %+v", got)
+	}
+	// All items should have been started or processed
+	if started == 0 {
+		t.Fatal("no items were processed")
+	}
+}
+
+func TestProcessAllCancellation(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd"}
+	var processed int32
+
+	ctx, cancel := context.WithCancel(context.Background())
+
+	got, err := ProcessAll(ctx, items, 1, func(_ context.Context, s string) (int, error) {
+		atomic.AddInt32(&processed, 1)
+		if s == "bb" {
+			cancel()
+		}
+		return len(s), nil
+	})
+
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil result on cancellation, got %+v", got)
+	}
+	// Ensure all started goroutines completed
+	if processed == 0 {
+		t.Fatal("no items were processed")
+	}
+}
