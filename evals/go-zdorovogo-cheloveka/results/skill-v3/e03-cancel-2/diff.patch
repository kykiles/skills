 	for w := 0; w < workers; w++ {
+		wg.Add(1)
 		go func() {
+			defer wg.Done()
 			for j := range jobs {
 				v, err := fn(ctx, j.item)
-				outcomes <- outcome{j.index, v, err}
+				select {
+				case outcomes <- outcome{j.index, v, err}:
+				case <-ctx.Done():
+					return
+				}
 			}
 		}()
 	}
 
 	go func() {
 		for i, item := range items {
-			jobs <- job{i, item}
+			select {
+			case jobs <- job{i, item}:
+			case <-ctx.Done():
+				break
+			}
 		}
 		close(jobs)
 	}()
 
 	results := make([]Result, len(items))
-	for range items {
+	for i := 0; i < len(items); i++ {
 		select {
 		case o := <-outcomes:
 			if o.err != nil {
-				return nil, o.err
+				mu.Lock()
+				if firstErr == nil {
+					firstErr = o.err
+					cancel()
+				}
+				mu.Unlock()
+			} else {
+				results[o.index] = Result{Item: items[o.index], Value: o.value}
 			}
-			results[o.index] = Result{Item: items[o.index], Value: o.value}
 		case <-ctx.Done():
-			return nil, ctx.Err()
+			mu.Lock()
+			if firstErr == nil {
+				firstErr = ctx.Err()
+			}
+			mu.Unlock()
 		}
 	}
+
+	wg.Wait()
+
+	if firstErr != nil {
+		return nil, firstErr
+	}
 	return results, nil
 }
