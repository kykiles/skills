+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Minute)
+	var wg sync.WaitGroup
+
+	// Запускаем множество горутин, одновременно записывающих и читающих
+	for i := 0; i < 10; i++ {
+		wg.Add(3)
+
+		// Горутина, которая пишет
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Set("key", "value")
+			}
+		}(i)
+
+		// Горутина, которая читает
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Get("key")
+			}
+		}(i)
+
+		// Горутина, которая проверяет длину
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Len()
+			}
+		}(i)
+	}
+
+	wg.Wait()
+}
+
+func TestCleanupConcurrency(t *testing.T) {
+	c := New(time.Millisecond * 100)
+	stop := c.StartCleanup(time.Millisecond * 50)
+	defer stop()
+
+	var wg sync.WaitGroup
+
+	// Пишем и читаем пока идёт очистка
+	for i := 0; i < 5; i++ {
+		wg.Add(2)
+
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 50; j++ {
+				c.Set("key", "value")
+				time.Sleep(time.Millisecond)
+			}
+		}(i)
+
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 50; j++ {
+				c.Get("key")
+				time.Sleep(time.Millisecond)
+			}
+		}(i)
+	}
+
+	wg.Wait()
+}
