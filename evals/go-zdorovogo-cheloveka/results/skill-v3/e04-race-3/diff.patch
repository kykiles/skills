+
+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Minute)
+	var wg sync.WaitGroup
+
+	// Concurrent Set operations
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Set("key", "value")
+			}
+		}(i)
+	}
+
+	// Concurrent Get operations
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Get("key")
+			}
+		}(i)
+	}
+
+	// Concurrent Len operations
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Len()
+			}
+		}(i)
+	}
+
+	wg.Wait()
+}
+
+func TestConcurrentCleanup(t *testing.T) {
+	c := New(10 * time.Millisecond)
+
+	var wg sync.WaitGroup
+
+	// Start cleanup
+	stop := c.StartCleanup(5 * time.Millisecond)
+	defer stop()
+
+	// Concurrent Set and Get operations while cleanup is running
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 50; j++ {
+				c.Set("key", "value")
+				c.Get("key")
+				c.Len()
+			}
+		}(i)
+	}
+
+	wg.Wait()
+}
