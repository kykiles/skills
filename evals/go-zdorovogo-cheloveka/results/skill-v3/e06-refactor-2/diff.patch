+
+// formatAndWriteSection форматирует и выводит одну секцию отчёта.
+// Для showMessages=true выводит уникальные сообщения в порядке появления.
+// Для showMessages=false выводит только количество уникальных сообщений.
+func formatAndWriteSection(b *strings.Builder, level Level, entries map[string][]Entry, showMessages bool) {
+	if len(entries) == 0 {
+		return
+	}
+
+	b.WriteString("\n[" + level.String() + "]\n")
+
+	var sources []string
+	for s := range entries {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		seen := map[string]bool{}
+		var msgs []string
+
+		for _, e := range entries[s] {
+			n += e.Count
+			if !seen[e.Message] {
+				seen[e.Message] = true
+				msgs = append(msgs, e.Message)
+			}
+		}
+		total += n
+
+		if showMessages {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, strings.Join(msgs, "; ")))
+		} else {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  (%d сообщ.)\n", s, n, len(seen)))
+		}
+	}
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+}
