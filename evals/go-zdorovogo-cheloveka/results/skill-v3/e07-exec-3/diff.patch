@@ -2,8 +2,10 @@
 
 import (
 	"context"
+	"errors"
 	"strings"
 	"testing"
+	"time"
 )
 
 func TestRunEcho(t *testing.T) {
@@ -15,3 +17,111 @@
 		t.Fatalf("Stdout = %q", res.Stdout)
 	}
 }
+
+// TestRunArgsWithSpaces проверяет, что аргументы с пробелами доходят как есть.
+func TestRunArgsWithSpaces(t *testing.T) {
+	res, err := Run(context.Background(), "echo", "hello world", "foo bar")
+	if err != nil {
+		t.Fatal(err)
+	}
+	out := strings.TrimSpace(res.Stdout)
+	if out != "hello world foo bar" {
+		t.Fatalf("Stdout = %q, want %q", out, "hello world foo bar")
+	}
+}
+
+// TestRunArgsWithShellChars проверяет, что спецсимволы не интерпретируются shell.
+func TestRunArgsWithShellChars(t *testing.T) {
+	// Проверяем, что ; не интерпретируется как разделитель команд.
+	res, err := Run(context.Background(), "printf", "a;b")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != "a;b" {
+		t.Fatalf("Stdout = %q, want %q", res.Stdout, "a;b")
+	}
+
+	// Проверяем, что * не раскрывается как глоб.
+	res, err = Run(context.Background(), "printf", "*")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != "*" {
+		t.Fatalf("Stdout = %q, want %q", res.Stdout, "*")
+	}
+
+	// Проверяем, что $VAR не раскрывается.
+	res, err = Run(context.Background(), "printf", "$HOME")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != "$HOME" {
+		t.Fatalf("Stdout = %q, want %q", res.Stdout, "$HOME")
+	}
+}
+
+// TestRunSeparateStdoutStderr проверяет, что stdout и stderr разделены.
+func TestRunSeparateStdoutStderr(t *testing.T) {
+	// Используем sh для вывода в обе потоки (если доступен).
+	// На Windows это может не сработать, но тест проверит работу разделения.
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout && echo stderr >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(res.Stdout) != "stdout" {
+		t.Fatalf("Stdout = %q, want %q", strings.TrimSpace(res.Stdout), "stdout")
+	}
+	if strings.TrimSpace(res.Stderr) != "stderr" {
+		t.Fatalf("Stderr = %q, want %q", strings.TrimSpace(res.Stderr), "stderr")
+	}
+}
+
+// TestRunNonzeroExitCode проверяет, что ненулевой exit code не ошибка.
+func TestRunNonzeroExitCode(t *testing.T) {
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("ExitCode = %d, want 42", res.ExitCode)
+	}
+}
+
+// TestRunProgramNotFound проверяет, что ошибка запуска программы возвращается.
+func TestRunProgramNotFound(t *testing.T) {
+	res, err := Run(context.Background(), "nonexistent-program-xyz-123", "arg")
+	if err == nil {
+		t.Fatalf("err = nil, want error")
+	}
+	if res.ExitCode != 0 {
+		t.Fatalf("ExitCode = %d, want 0", res.ExitCode)
+	}
+}
+
+// TestRunContextCanceled проверяет отмену контекста.
+func TestRunContextCanceled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // отменяем сразу
+
+	_, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatalf("err = nil, want error")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("errors.Is(err, context.Canceled) = false, want true (err = %v)", err)
+	}
+}
+
+// TestRunContextDeadline проверяет timeout.
+func TestRunContextDeadline(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	_, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatalf("err = nil, want error")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("errors.Is(err, context.DeadlineExceeded) = false, want true (err = %v)", err)
+	}
+}
