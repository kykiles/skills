+++ ws/runner.go	2026-10-01 13:52:43.533722183 +0000
@@ -4,8 +4,9 @@
 import (
 	"bytes"
 	"context"
+	"errors"
 	"os/exec"
-	"strings"
+	"time"
 )
 
 // Result — итог работы программы.
@@ -15,12 +16,40 @@
 	ExitCode int
 }
 
-// Run запускает программу name с аргументами args и ждёт её завершения.
+// Run запускает программу name с аргументами args без интерпретации shell.
+// Аргументы (пробелы, кавычки, $, *, ;, и др.) доходят до программы как есть.
+// Stdout и stderr возвращаются раздельно в Result.
+//
+// Ненулевой код выхода не считается ошибкой; он записывается в Result.ExitCode.
+// Ошибка возвращается только если:
+//   - программа не запустилась (файл не найден, нет прав и т.п.);
+//   - при отмене ctx программа была прервана (для такой ошибки errors.Is(err, ctx.Err()) истинно).
+//
+// При отмене ctx программа останавливается, Run возвращает ошибку,
+// для которой errors.Is(err, context.Canceled) или errors.Is(err, context.DeadlineExceeded) истинно.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	cmd.WaitDelay = 5 * time.Second // не ждать вечно, если потомки держат stdout/stderr
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+	res := Result{Stdout: stdout.String(), Stderr: stderr.String()}
+
+	// Если контекст был отменён и произошла ошибка, возвращаем ошибку отмены.
+	if err != nil && ctx.Err() != nil {
+		return res, ctx.Err()
+	}
+
+	// Если это ошибка выхода (программа запустилась, но вернула ненулевой код),
+	// кладём код в Result и не возвращаем ошибку.
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		res.ExitCode = exitErr.ExitCode()
+		return res, nil
+	}
+
+	// Иные ошибки (файл не найден и т.п.) возвращаются как есть.
+	return res, err
 }
diff -ruN -x .git orig/runner_test.go ws/runner_test.go
