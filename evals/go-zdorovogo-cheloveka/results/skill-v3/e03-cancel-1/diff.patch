+// TestProcessAllErrorStopsNewItems проверяет, что при ошибке ProcessAll
+// прекращает выдавать новые элементы и возвращает управление.
+func TestProcessAllErrorStopsNewItems(t *testing.T) {
+	items := []string{"a", "b", "c", "d", "e"}
+	callCount := 0
+	got, err := ProcessAll(context.Background(), items, 1, func(_ context.Context, s string) (int, error) {
+		callCount++
+		// Возвращаем ошибку на третьем элементе
+		if callCount == 3 {
+			return 0, errors.New("test error")
+		}
+		return len(s), nil
+	})
+
+	if err == nil || err.Error() != "test error" {
+		t.Fatalf("expected error 'test error', got %v", err)
+	}
+
+	if got != nil {
+		t.Fatalf("expected nil result, got %v", got)
+	}
+
+	// callCount должен быть <= 5 (может быть запущен еще элемент до отмены)
+	if callCount > 5 {
+		t.Fatalf("too many calls to fn: %d (should be <= 5)", callCount)
+	}
+}
+
+// TestProcessAllGoroutineCleanup проверяет, что горутины завершаются
+// после ошибки (не растут).
+func TestProcessAllGoroutineCleanup(t *testing.T) {
+	// Количество горутин перед тестом
+	initialGoroutines := runtime.NumGoroutine()
+
+	items := []string{"a", "b", "c"}
+	_, err := ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		if s == "b" {
+			return 0, errors.New("test error")
+		}
+		return len(s), nil
+	})
+
+	if err == nil || err.Error() != "test error" {
+		t.Fatalf("expected error, got %v", err)
+	}
+
+	// Даём время горутинам завершиться
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+
+	if finalGoroutines > initialGoroutines {
+		t.Fatalf("goroutine leak: started with %d, ended with %d",
+			initialGoroutines, finalGoroutines)
+	}
+}
+
+// TestProcessAllContextCancellation проверяет, что при отмене ctx
+// ProcessAll не возвращает управление, пока не завершатся все горутины.
+func TestProcessAllContextCancellation(t *testing.T) {
+	items := make([]string, 100)
+	for i := range items {
+		items[i] = fmt.Sprintf("item%d", i)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	// Отменяем контекст после короткой задержки
+	time.AfterFunc(50*time.Millisecond, cancel)
+
+	got, err := ProcessAll(ctx, items, 10, func(ctx context.Context, s string) (int, error) {
+		// Работаем некоторое время
+		select {
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		case <-time.After(10 * time.Millisecond):
+			return len(s), nil
+		}
+	})
+
+	if err == nil || err != context.Canceled {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+
+	if got != nil {
+		t.Fatalf("expected nil result, got %v", got)
+	}
+}
+
+// TestProcessAllNoGoroutineLeakOnCancel проверяет, что при отмене ctx
+// горутины корректно завершаются.
+func TestProcessAllNoGoroutineLeakOnCancel(t *testing.T) {
+	initialGoroutines := runtime.NumGoroutine()
+
+	items := make([]string, 50)
+	for i := range items {
+		items[i] = fmt.Sprintf("item%d", i)
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+
+	// Отменяем контекст после короткой задержки
+	time.AfterFunc(30*time.Millisecond, cancel)
+
+	_, err := ProcessAll(ctx, items, 10, func(ctx context.Context, s string) (int, error) {
+		// Работаем дольше, чем время до отмены
+		select {
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		case <-time.After(1 * time.Second):
+			return len(s), nil
+		}
+	})
+
+	if err != context.Canceled {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+
+	// Даём время горутинам завершиться
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+
+	if finalGoroutines > initialGoroutines {
+		t.Fatalf("goroutine leak on cancel: started with %d, ended with %d",
+			initialGoroutines, finalGoroutines)
+	}
+}
