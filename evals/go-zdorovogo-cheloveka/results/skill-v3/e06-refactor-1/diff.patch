+// formatSection форматирует одну секцию отчёта для уровня.
+// includeMessages определяет, выводить ли сообщения или только их количество.
+func formatSection(level Level, entries map[string][]Entry, includeMessages bool) string {
+	if len(entries) == 0 {
+		return ""
+	}
+
+	var b strings.Builder
+	b.WriteString("\n[" + level.String() + "]\n")
+
+	var sources []string
+	for s := range entries {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		var msgs []string
+		seen := map[string]bool{}
+
+		for _, e := range entries[s] {
+			n += e.Count
+			if !seen[e.Message] {
+				seen[e.Message] = true
+				if includeMessages {
+					msgs = append(msgs, e.Message)
+				}
+			}
+		}
+
+		total += n
+
+		if includeMessages {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, strings.Join(msgs, "; ")))
+		} else {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  (%d сообщ.)\n", s, n, len(seen)))
+		}
+	}
+
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+	return b.String()
+}
+
