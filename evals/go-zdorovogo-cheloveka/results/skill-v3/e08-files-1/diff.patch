@@ -1,8 +1,10 @@
 package logscan
 
 import (
+	"fmt"
 	"os"
 	"path/filepath"
+	"strings"
 	"testing"
 )
 
@@ -20,3 +22,99 @@
 		t.Fatalf("CountMatches = %v; want 2", got)
 	}
 }
+
+// TestCountMatchesManyFiles проверяет, что функция корректно обрабатывает
+// большое количество файлов и закрывает их между итерациями
+// (предотвращает "too many open files").
+func TestCountMatchesManyFiles(t *testing.T) {
+	dir := t.TempDir()
+	var paths []string
+	numFiles := 100
+
+	// Создаём много файлов с совпадениями.
+	for i := 0; i < numFiles; i++ {
+		p := filepath.Join(dir, fmt.Sprintf("log%d.log", i))
+		content := "error\nok\nerror\n"
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		paths = append(paths, p)
+	}
+
+	got, err := CountMatches(paths, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	// Проверяем, что каждый файл обработан корректно.
+	if len(got) != numFiles {
+		t.Fatalf("CountMatches returned %d files; want %d", len(got), numFiles)
+	}
+	for _, p := range paths {
+		if got[p] != 2 {
+			t.Fatalf("CountMatches(%s) = %d; want 2", p, got[p])
+		}
+	}
+}
+
+// TestCountMatchesLargeLines проверяет обработку очень больших строк
+// (больше стандартного буфера Scanner 64 КиБ).
+func TestCountMatchesLargeLines(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "large.log")
+
+	// Создаём файл со строками, длиннее 64 КиБ.
+	largeStr := strings.Repeat("x", 100*1024) // 100 КиБ
+	content := "ok\n" + largeStr + "error\n" + largeStr + "error\n"
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := CountMatches([]string{p}, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	if got[p] != 2 {
+		t.Fatalf("CountMatches = %d; want 2", got[p])
+	}
+}
+
+// TestCountMatchesMultipleWithLargeLines проверяет сочетание обработки
+// множества файлов с очень большими строками.
+func TestCountMatchesMultipleWithLargeLines(t *testing.T) {
+	dir := t.TempDir()
+	var paths []string
+
+	largeStr := strings.Repeat("y", 200*1024) // 200 КиБ
+	for i := 0; i < 10; i++ {
+		p := filepath.Join(dir, fmt.Sprintf("large%d.log", i))
+		content := largeStr + "error\n" + largeStr + "ok\n"
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		paths = append(paths, p)
+	}
+
+	got, err := CountMatches(paths, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	if len(got) != 10 {
+		t.Fatalf("CountMatches returned %d files; want 10", len(got))
+	}
+	for _, p := range paths {
+		if got[p] != 1 {
+			t.Fatalf("CountMatches(%s) = %d; want 1", p, got[p])
+		}
+	}
+}
+
+// TestCountMatchesFileNotFound проверяет обработку несуществующего файла.
+func TestCountMatchesFileNotFound(t *testing.T) {
+	_, err := CountMatches([]string{"/nonexistent/file.log"}, "error")
+	if err == nil {
+		t.Fatal("CountMatches should return error for nonexistent file")
+	}
+}
