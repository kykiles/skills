+
+// countFileMatches возвращает число строк в файле path, содержащих needle.
+// Файл закрывается перед возвратом из функции.
+func countFileMatches(path, needle string) (int, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0, err
+	}
+	defer f.Close()
+
+	n := 0
+	sc := bufio.NewScanner(f)
+	// Увеличиваем буфер для обработки больших строк (до 10 МБ на строку).
+	buf := make([]byte, 0, 64*1024)
+	sc.Buffer(buf, 10*1024*1024)
+
+	for sc.Scan() {
+		if strings.Contains(sc.Text(), needle) {
+			n++
+		}
+	}
+
+	// Проверяем ошибку Scanner: может быть, буфер был переполнен или произошла
+	// ошибка чтения.
+	if err := sc.Err(); err != nil {
+		return 0, err
+	}
+
+	return n, nil
+}
diff -ruN -x .git orig/scan_test.go ws/scan_test.go
