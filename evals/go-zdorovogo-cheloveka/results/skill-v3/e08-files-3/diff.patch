+// TestCountMatchesManyFiles verifies that many files can be processed without
+// "too many open files" error. Files are closed after each iteration.
+func TestCountMatchesManyFiles(t *testing.T) {
+	dir := t.TempDir()
+	const numFiles = 100
+	var paths []string
+
+	for i := 0; i < numFiles; i++ {
+		p := filepath.Join(dir, "log"+strings.Repeat("0", 5-len(strings.TrimLeft(strconv.Itoa(i), "0")))+strconv.Itoa(i)+".log")
+		data := []byte("line1\nerror\nline3\n")
+		if err := os.WriteFile(p, data, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		paths = append(paths, p)
+	}
+
+	got, err := CountMatches(paths, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	if len(got) != numFiles {
+		t.Fatalf("CountMatches returned %d files; want %d", len(got), numFiles)
+	}
+
+	for _, p := range paths {
+		if got[p] != 1 {
+			t.Fatalf("CountMatches for %s = %v; want 1", p, got[p])
+		}
+	}
+}
+
+// TestCountMatchesLargeFiles verifies that large files (with many lines) are read
+// completely without missed matches.
+func TestCountMatchesLargeFiles(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "large.log")
+
+	// Create a large file with many lines (5MB total)
+	var buf bytes.Buffer
+	const lineSize = 100
+	const numLines = 50000
+	for i := 0; i < numLines; i++ {
+		if i%1000 == 0 {
+			buf.WriteString("error line " + strconv.Itoa(i) + "\n")
+		} else {
+			buf.WriteString(strings.Repeat("x", lineSize) + "\n")
+		}
+	}
+
+	if err := os.WriteFile(p, buf.Bytes(), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := CountMatches([]string{p}, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	expectedCount := numLines / 1000
+	if got[p] != expectedCount {
+		t.Fatalf("CountMatches = %v; want %d", got[p], expectedCount)
+	}
+}
