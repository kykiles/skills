 import (
 	"bytes"
 	"context"
+	"errors"
 	"os/exec"
-	"strings"
+	"time"
 )
 
 // Result — итог работы программы.
@@ -15,12 +16,30 @@
 	ExitCode int
 }
 
-// Run запускает программу name с аргументами args и ждёт её завершения.
+// Run запускает программу name с аргументами args, без shell, и ждёт её завершения.
+//
+// Аргументы доходят до программы как есть: пробелы, кавычки, `;`, `$`, `*` не интерпретируются.
+// Stdout и stderr собираются отдельно в Result. Ненулевой код выхода кладётся в Result.ExitCode
+// и не считается ошибкой; ошибка возвращается только если программу не удалось запустить или
+// она была прервана отменой ctx. При отмене контекста программа останавливается и Run возвращает
+// ошибку err такую, что errors.Is(err, ctx.Err()) истинно.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	cmd.WaitDelay = 5 * time.Second // не ждать вечно, если потомки держат stdout/stderr
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+	res := Result{Stdout: stdout.String(), Stderr: stderr.String()}
+	if err != nil && ctx.Err() != nil {
+		// Процесс, убитый при отмене, выглядит как ExitError: сообщаем об отмене.
+		return res, ctx.Err()
+	}
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		res.ExitCode = exitErr.ExitCode()
+		return res, nil
+	}
+	return res, err
 }
