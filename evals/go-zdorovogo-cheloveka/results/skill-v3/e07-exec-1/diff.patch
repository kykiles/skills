 )
 
 func TestRunEcho(t *testing.T) {
@@ -15,3 +17,76 @@
 		t.Fatalf("Stdout = %q", res.Stdout)
 	}
 }
+
+func TestRunArgsWithSpaces(t *testing.T) {
+	// Аргумент с пробелом должен доходить как есть, без интерпретации.
+	res, err := Run(context.Background(), "echo", "hello world")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(res.Stdout) != "hello world" {
+		t.Fatalf("Stdout = %q, want 'hello world'", strings.TrimSpace(res.Stdout))
+	}
+}
+
+func TestRunStdoutStderr(t *testing.T) {
+	// Stdout и stderr должны быть отдельны.
+	// Используем команду, которая пишет в оба потока.
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout; echo stderr >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(res.Stdout, "stdout") {
+		t.Fatalf("Stdout = %q, want to contain 'stdout'", res.Stdout)
+	}
+	if !strings.Contains(res.Stderr, "stderr") {
+		t.Fatalf("Stderr = %q, want to contain 'stderr'", res.Stderr)
+	}
+}
+
+func TestRunNonZeroExit(t *testing.T) {
+	// Ненулевой код выхода не должен быть ошибкой.
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatalf("err = %v, want nil", err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("ExitCode = %d, want 42", res.ExitCode)
+	}
+}
+
+func TestRunContextCanceled(t *testing.T) {
+	// При отмене контекста должна вернуться ошибка, проверяемая errors.Is(err, context.Canceled).
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	_, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatal("err is nil, want context.Canceled")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("err = %v, want context.Canceled", err)
+	}
+}
+
+func TestRunCommandNotFound(t *testing.T) {
+	// Если программа не найдена, должна вернуться ошибка.
+	_, err := Run(context.Background(), "nonexistent_program_xyz", "arg")
+	if err == nil {
+		t.Fatal("err is nil, want an error")
+	}
+}
+
+func TestRunContextDeadline(t *testing.T) {
+	// При превышении deadline контекста программа должна быть остановлена.
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	_, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatal("err is nil, want context.DeadlineExceeded")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("err = %v, want context.DeadlineExceeded", err)
+	}
+}
