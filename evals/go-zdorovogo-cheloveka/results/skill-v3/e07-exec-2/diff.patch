@@ -4,8 +4,9 @@
 import (
 	"bytes"
 	"context"
+	"errors"
 	"os/exec"
-	"strings"
+	"time"
 )
 
 // Result — итог работы программы.
@@ -15,12 +16,30 @@
 	ExitCode int
 }
 
-// Run запускает программу name с аргументами args и ждёт её завершения.
+// Run запускает программу name с аргументами args, используя контекст ctx.
+// Каждый аргумент доходит до программы как есть: пробелы, кавычки, ;, $, *
+// не интерпретируются.
+//
+// Ненулевой код выхода — не ошибка; код кладётся в Result.ExitCode.
+// Ошибка возвращается только если:
+//   - программу не удалось запустить;
+//   - ctx был отменён, и для возвращённой ошибки errors.Is(err, ctx.Err()) истинно.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	cmd.WaitDelay = 5 * time.Second
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+	res := Result{Stdout: stdout.String(), Stderr: stderr.String()}
+	if err != nil && ctx.Err() != nil {
+		// Процесс, убитый при отмене, выглядит как ExitError: сообщаем об отмене.
+		return res, ctx.Err()
+	}
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		res.ExitCode = exitErr.ExitCode()
+		return res, nil
+	}
+	return res, err
 }
