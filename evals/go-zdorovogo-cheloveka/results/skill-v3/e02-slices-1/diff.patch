+func TestMultipleCommands(t *testing.T) {
+	// Проверяем, что разные команды с одним профилем не влияют друг на друга
+	profile := NewProfile("--user-flag")
+
+	cmd1 := profile.Command("extra1")
+	cmd2 := profile.Command("extra2")
+
+	// cmd1 должна быть: ["--quiet", "--color=never", "--user-flag", "extra1"]
+	// cmd2 должна быть: ["--quiet", "--color=never", "--user-flag", "extra2"]
+	want1 := []string{"--quiet", "--color=never", "--user-flag", "extra1"}
+	want2 := []string{"--quiet", "--color=never", "--user-flag", "extra2"}
+
+	if !slices.Equal(cmd1, want1) {
+		t.Fatalf("cmd1 = %q; want %q", cmd1, want1)
+	}
+	if !slices.Equal(cmd2, want2) {
+		t.Fatalf("cmd2 = %q; want %q", cmd2, want2)
+	}
+}
+
+func TestBuildDoesNotModifyInput(t *testing.T) {
+	// Проверяем, что Build не модифицирует входной срез
+	base := []string{"a", "b"}
+	baseCopy := []string{"a", "b"}
+	_ = Build(base, "c")
+	if !slices.Equal(base, baseCopy) {
+		t.Fatalf("Build modified input: got %q; want %q", base, baseCopy)
+	}
+}
+
+func TestWithoutEmptyDoesNotModifyInput(t *testing.T) {
+	// Проверяем, что WithoutEmpty не модифицирует входной срез
+	args := []string{"a", "", "b"}
+	argsCopy := []string{"a", "", "b"}
+	_ = WithoutEmpty(args)
+	if !slices.Equal(args, argsCopy) {
+		t.Fatalf("WithoutEmpty modified input: got %q; want %q", args, argsCopy)
+	}
+}
