+// TestConcurrentAccess проверяет, что кэш безопасен при одновременном доступе.
+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Minute)
+	var wg sync.WaitGroup
+
+	// Горутины, которые пишут в кэш
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Set("key", "value")
+			}
+		}(i)
+	}
+
+	// Горутины, которые читают из кэша
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Get("key")
+			}
+		}(i)
+	}
+
+	// Горутины, которые вызывают Len
+	for i := 0; i < 5; i++ {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Len()
+			}
+		}(i)
+	}
+
+	// Горутина cleanup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		c.Set("cleanup-test", "value")
+		stop := c.StartCleanup(10 * time.Millisecond)
+		time.Sleep(100 * time.Millisecond)
+		stop()
+	}()
+
+	wg.Wait()
+}
