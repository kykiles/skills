+// formatSection форматирует одну секцию отчёта.
+// formatter преобразует данные источника в строку для вывода.
+func formatSection(b *strings.Builder, level Level, data map[string][]Entry, formatter func(string, []Entry) (string, int)) {
+	b.WriteString("\n[" + level.String() + "]\n")
+	var sources []string
+	for s := range data {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+	total := 0
+	for _, s := range sources {
+		line, n := formatter(s, data[s])
+		total += n
+		b.WriteString(line)
+	}
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+}
+
+// formatCriticalWarning форматирует строку для Critical и Warning уровней:
+// выводит уникальные сообщения в порядке появления.
+func formatCriticalWarning(source string, entries []Entry) (string, int) {
+	n := 0
+	var msgs []string
+	seen := map[string]bool{}
+	for _, e := range entries {
+		n += e.Count
+		if !seen[e.Message] {
+			seen[e.Message] = true
+			msgs = append(msgs, e.Message)
+		}
+	}
+	return fmt.Sprintf("  %-12s %5d  %s\n", source, n, strings.Join(msgs, "; ")), n
+}
+
+// formatInfo форматирует строку для Info уровня:
+// выводит только количество уникальных сообщений.
+func formatInfo(source string, entries []Entry) (string, int) {
+	n := 0
+	seen := map[string]bool{}
+	for _, e := range entries {
+		n += e.Count
+		seen[e.Message] = true
+	}
+	return fmt.Sprintf("  %-12s %5d  (%d сообщ.)\n", source, n, len(seen)), n
+}
