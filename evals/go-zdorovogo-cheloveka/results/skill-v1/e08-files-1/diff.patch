@@ -1,6 +1,7 @@
 package logscan
 
 import (
+	"fmt"
 	"os"
 	"path/filepath"
 	"testing"
@@ -20,3 +21,29 @@
 		t.Fatalf("CountMatches = %v; want 2", got)
 	}
 }
+
+func TestCountMatchesManyFiles(t *testing.T) {
+	// Test that CountMatches handles many files without hitting "too many open files" error
+	dir := t.TempDir()
+	paths := make([]string, 100)
+	for i := 0; i < 100; i++ {
+		p := filepath.Join(dir, fmt.Sprintf("file%d.log", i))
+		content := "line with error\nline without\nerror again\n"
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		paths[i] = p
+	}
+	got, err := CountMatches(paths, "error")
+	if err != nil {
+		t.Fatalf("CountMatches with many files failed: %v", err)
+	}
+	if len(got) != 100 {
+		t.Fatalf("CountMatches returned results for %d files; want 100", len(got))
+	}
+	for _, p := range paths {
+		if got[p] != 2 {
+			t.Fatalf("CountMatches[%s] = %d; want 2", p, got[p])
+		}
+	}
+}
