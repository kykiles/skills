 // Result — итог работы программы.
@@ -16,11 +15,39 @@
 }
 
 // Run запускает программу name с аргументами args и ждёт её завершения.
+// Аргументы передаются программе без интерпретации оболочкой.
+// Возвращает результат с stdout и stderr раздельно и кодом выхода программы.
+// Ненулевой код выхода не является ошибкой; код помещается в Result.ExitCode.
+// Ошибка возвращается только если программу не удалось запустить или процесс был прерван.
+// При отмене ctx программа останавливается и Run возвращает ошибку,
+// для которой errors.Is(err, ctx.Err()) истинно.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+
+	res := Result{
+		Stdout:   stdout.String(),
+		Stderr:   stderr.String(),
+		ExitCode: 0,
+	}
+
+	// Если процесс был убит при отмене контекста, вернём ошибку контекста
+	if ctx.Err() != nil {
+		return res, ctx.Err()
+	}
+
+	// Если произошла другая ошибка запуска (не код выхода), вернём её
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			res.ExitCode = exitErr.ExitCode()
+		} else {
+			return res, err
+		}
+	}
+
+	return res, nil
 }
