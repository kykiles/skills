+// TestRunStdoutStderr проверяет, что stdout и stderr разделены
+func TestRunStdoutStderr(t *testing.T) {
+	// Используем sh для записи в stderr (так как echo пишет только в stdout)
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout_msg && echo stderr_msg >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(res.Stdout) != "stdout_msg" {
+		t.Fatalf("Stdout = %q, want %q", strings.TrimSpace(res.Stdout), "stdout_msg")
+	}
+	if strings.TrimSpace(res.Stderr) != "stderr_msg" {
+		t.Fatalf("Stderr = %q, want %q", strings.TrimSpace(res.Stderr), "stderr_msg")
+	}
+}
