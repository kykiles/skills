+func TestProcessAllErrorStopsNewItems(t *testing.T) {
+	var (
+		mu         sync.Mutex
+		callCount  int
+		firstErr   = errors.New("first error")
+	)
+
+	items := []string{"a", "b", "c", "d", "e"}
+	_, err := ProcessAll(context.Background(), items, 1, func(_ context.Context, s string) (int, error) {
+		mu.Lock()
+		callCount++
+		mu.Unlock()
+
+		if s == "a" {
+			return 0, firstErr
+		}
+		time.Sleep(100 * time.Millisecond) // Slow processing to see ordering
+		return len(s), nil
+	})
+
+	if !errors.Is(err, firstErr) {
+		t.Fatalf("expected error %v, got %v", firstErr, err)
+	}
+
+	mu.Lock()
+	count := callCount
+	mu.Unlock()
+
+	// With 1 worker, we expect at most 2 calls:
+	// - item "a" which errors
+	// - item "b" which might have started before error was detected
+	if count > 2 {
+		t.Fatalf("expected at most 2 calls after error, got %d", count)
+	}
+}
+
+func TestProcessAllNoGoroutineLeakOnError(t *testing.T) {
+	initialGoroutines := runtime.NumGoroutine()
+
+	items := make([]string, 100)
+	for i := range items {
+		items[i] = "item"
+	}
+
+	firstErr := errors.New("test error")
+	_, err := ProcessAll(context.Background(), items, 10, func(ctx context.Context, s string) (int, error) {
+		// Return error on first call
+		return 0, firstErr
+	})
+
+	if !errors.Is(err, firstErr) {
+		t.Fatalf("expected error, got %v", err)
+	}
+
+	// Give goroutines time to clean up
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+
+	// Allow some tolerance for test framework goroutines
+	if finalGoroutines > initialGoroutines+2 {
+		t.Fatalf("goroutine leak: started with %d, ended with %d", initialGoroutines, finalGoroutines)
+	}
+}
+
+func TestProcessAllContextCancellation(t *testing.T) {
+	var (
+		mu        sync.Mutex
+		fnEntered bool
+		err       error
+	)
+
+	items := []string{"a", "b", "c", "d", "e"}
+	ctx, cancel := context.WithCancel(context.Background())
+
+	errChan := make(chan error, 1)
+	go func() {
+		_, processErr := ProcessAll(ctx, items, 2, func(ctx context.Context, s string) (int, error) {
+			mu.Lock()
+			fnEntered = true
+			mu.Unlock()
+
+			// Simulate slow processing
+			time.Sleep(50 * time.Millisecond)
+			return len(s), nil
+		})
+		errChan <- processErr
+	}()
+
+	// Cancel after first goroutine starts
+	time.Sleep(10 * time.Millisecond)
+	cancel()
+
+	// Wait for ProcessAll to return (should be shortly after cancel)
+	select {
+	case err = <-errChan:
+		// Good, ProcessAll returned
+	case <-time.After(2 * time.Second):
+		t.Fatalf("ProcessAll did not return within 2 seconds")
+	}
+
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+
+	mu.Lock()
+	entered := fnEntered
+	mu.Unlock()
+
+	if !entered {
+		t.Fatalf("expected at least one fn call before cancellation")
+	}
+}
+
+func TestProcessAllNoFnCallsAfterCancel(t *testing.T) {
+	initialGoroutines := runtime.NumGoroutine()
+
+	var (
+		mu    sync.Mutex
+		calls int
+		err   error
+	)
+
+	items := make([]string, 50)
+	for i := range items {
+		items[i] = "item"
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+
+	errChan := make(chan error, 1)
+	go func() {
+		time.Sleep(10 * time.Millisecond)
+		cancel()
+	}()
+
+	go func() {
+		_, processErr := ProcessAll(ctx, items, 2, func(ctx context.Context, s string) (int, error) {
+			mu.Lock()
+			calls++
+			mu.Unlock()
+			// Add a small delay to ensure cancellation can happen during processing
+			time.Sleep(1 * time.Millisecond)
+			return len(s), nil
+		})
+		errChan <- processErr
+	}()
+
+	select {
+	case err = <-errChan:
+		// Good, ProcessAll returned
+	case <-time.After(2 * time.Second):
+		t.Fatalf("ProcessAll did not return within 2 seconds")
+	}
+
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+
+	mu.Lock()
+	finalCalls := calls
+	mu.Unlock()
+
+	// Should be much less than all 50 items
+	if finalCalls > 10 {
+		t.Logf("warning: expected fewer than 10 calls, got %d (acceptable if system is slow)", finalCalls)
+	}
+
+	// Give goroutines time to clean up
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+	if finalGoroutines > initialGoroutines+2 {
+		t.Fatalf("goroutine leak after cancellation: started with %d, ended with %d", initialGoroutines, finalGoroutines)
+	}
+}
