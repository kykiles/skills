+func TestProfileSharedUnderlying(t *testing.T) {
+	// Reproduce the bug: two commands using the same profile
+	// should have independent arguments, but they share the underlying array.
+	profile := NewProfile()
+
+	// Collect arguments for two commands in advance
+	cmd1Args := profile.Command("cmd1", "arg1")
+	cmd2Args := profile.Command("cmd2", "arg2")
+
+	// cmd1Args should be: --quiet, --color=never, cmd1, arg1
+	// cmd2Args should be: --quiet, --color=never, cmd2, arg2
+
+	wantCmd1 := []string{"--quiet", "--color=never", "cmd1", "arg1"}
+	wantCmd2 := []string{"--quiet", "--color=never", "cmd2", "arg2"}
+
+	if !slices.Equal(cmd1Args, wantCmd1) {
+		t.Errorf("cmd1Args = %q; want %q", cmd1Args, wantCmd1)
+	}
+	if !slices.Equal(cmd2Args, wantCmd2) {
+		t.Errorf("cmd2Args = %q; want %q", cmd2Args, wantCmd2)
+	}
+}
