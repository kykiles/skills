+
+func TestRunArgumentsWithSpaces(t *testing.T) {
+	// Test that arguments with spaces are passed correctly without shell interpretation.
+	// Using the test binary itself as a subprocess that echoes its arguments.
+	res, err := Run(context.Background(), "sh", "-c", "echo 'hello world' '$HOME'")
+	if err != nil {
+		t.Fatal(err)
+	}
+	output := strings.TrimSpace(res.Stdout)
+	// sh -c should expand $HOME and interpret quotes as part of the echo command
+	if !strings.Contains(output, "hello world") {
+		t.Fatalf("Stdout should contain 'hello world', got: %q", output)
+	}
+}
+
+func TestRunArgumentsWithSpecialChars(t *testing.T) {
+	// Test that special characters like $ and ; are passed literally
+	// without shell interpretation.
+	res, err := Run(context.Background(), "printf", "test;value")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != "test;value" {
+		t.Fatalf("Stdout = %q, expected %q", res.Stdout, "test;value")
+	}
+}
+
+func TestRunSeparateStdoutStderr(t *testing.T) {
+	// Run a command that writes to both stdout and stderr.
+	// We use a shell script for this test.
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout_line; echo stderr_line >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !strings.Contains(res.Stdout, "stdout_line") {
+		t.Fatalf("Stdout should contain 'stdout_line', got: %q", res.Stdout)
+	}
+	if !strings.Contains(res.Stderr, "stderr_line") {
+		t.Fatalf("Stderr should contain 'stderr_line', got: %q", res.Stderr)
+	}
+}
+
+func TestRunNonZeroExitCode(t *testing.T) {
+	// Test that non-zero exit codes are returned in Result.ExitCode, not as errors.
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatalf("Run should not return error for non-zero exit code, got: %v", err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("ExitCode = %d, expected 42", res.ExitCode)
+	}
+}
+
+func TestRunContextCancellation(t *testing.T) {
+	// Test that context cancellation stops the process and returns ctx.Err().
+	ctx, cancel := context.WithCancel(context.Background())
+
+	// Start a background goroutine that cancels the context quickly.
+	go func() {
+		time.Sleep(10 * time.Millisecond)
+		cancel()
+	}()
+
+	// Run a long-sleeping process that should be interrupted.
+	res, err := Run(ctx, "sleep", "10")
+
+	// The process should be killed due to context cancellation.
+	if err == nil {
+		t.Fatal("Run should return error for cancelled context")
+	}
+
+	// Verify that errors.Is(err, ctx.Err()) is true.
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("errors.Is(err, context.Canceled) should be true, err = %v", err)
+	}
+
+	// The result should still be populated with stdout/stderr/exitcode if available.
+	_ = res
+}
