 }
+
+// testProg — вспомогательная программа для тестов (сам тестовый бинарник).
+func testProg(mode string) string {
+	exe, err := os.Executable()
+	if err != nil {
+		return ""
+	}
+	return exe + " -test.run=^$ -args " + mode
+}
+
+// TestArgsWithSpecialChars проверяет, что аргументы с пробелами, кавычками и спецсимволами
+// доходят до программы как есть.
+func TestArgsWithSpecialChars(t *testing.T) {
+	res, err := Run(context.Background(), "printf", "%s\n", "hello world; $USER * 'quote'")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(res.Stdout, "hello world; $USER * 'quote'") {
+		t.Fatalf("Stdout = %q, expected to contain argument with special chars", res.Stdout)
+	}
+}
+
+// TestStdoutStderr проверяет, что stdout и stderr собираются раздельно.
+func TestStdoutStderr(t *testing.T) {
+	// Используем программу, которая пишет в оба потока.
+	// На Unix можно использовать sh, на Windows тоже cmd доступен, но для портативности
+	// используем сам тестовый бинарник.
+	tmpdir := t.TempDir()
+	progPath := filepath.Join(tmpdir, "testprog.go")
+	err := os.WriteFile(progPath, []byte(`package main
+import (
+	"fmt"
+	"os"
+)
+func main() {
+	fmt.Fprint(os.Stdout, "stdout text")
+	fmt.Fprint(os.Stderr, "stderr text")
+}
+`), 0o644)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Запускаем go run для простоты
+	res, err := Run(context.Background(), "go", "run", progPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(res.Stdout, "stdout text") {
+		t.Fatalf("Stdout = %q, expected to contain 'stdout text'", res.Stdout)
+	}
+	if !strings.Contains(res.Stderr, "stderr text") {
+		t.Fatalf("Stderr = %q, expected to contain 'stderr text'", res.Stderr)
+	}
+}
+
+// TestExitCode проверяет, что ненулевой код выхода кладётся в Result.ExitCode, а не ошибку.
+func TestExitCode(t *testing.T) {
+	// Запускаем false — завершается с кодом 1.
+	res, err := Run(context.Background(), "false")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.ExitCode != 1 {
+		t.Fatalf("ExitCode = %d, want 1", res.ExitCode)
+	}
+}
+
+// TestContextCancel проверяет, что отмена ctx останавливает программу и возвращает контекстную ошибку.
+func TestContextCancel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // отменяем сразу
+
+	res, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatal("expected error due to context cancellation")
+	}
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected error to be context.Canceled, got %v", err)
+	}
+	// Программа не должна была завершиться нормально: код выхода не должен быть 0.
+	if res.ExitCode == 0 && res.Stdout == "" && res.Stderr == "" {
+		// OK
+	}
+}
