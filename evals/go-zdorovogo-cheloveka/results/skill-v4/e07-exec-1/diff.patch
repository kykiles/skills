 	"strings"
 	"testing"
 )
@@ -15,3 +16,44 @@
 		t.Fatalf("Stdout = %q", res.Stdout)
 	}
 }
+
+// TestRunExitCode проверяет, что ненулевой код выхода попадает в Result.ExitCode, а не в ошибку.
+func TestRunExitCode(t *testing.T) {
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatalf("err should be nil, got %v", err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("ExitCode = %d, want 42", res.ExitCode)
+	}
+}
+
+// TestRunStdoutStderr проверяет, что stdout и stderr собираются отдельно.
+func TestRunStdoutStderr(t *testing.T) {
+	res, err := Run(context.Background(), "sh", "-c", "echo out; echo err >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(res.Stdout) != "out" {
+		t.Fatalf("Stdout = %q, want %q", res.Stdout, "out\n")
+	}
+	if strings.TrimSpace(res.Stderr) != "err" {
+		t.Fatalf("Stderr = %q, want %q", res.Stderr, "err\n")
+	}
+}
+
+// TestRunCommandNotFound проверяет, что ошибка возвращается, если программа не найдена.
+func TestRunCommandNotFound(t *testing.T) {
+	res, err := Run(context.Background(), "nonexistent_program_xyz", "arg")
+	if err == nil {
+		t.Fatal("err should not be nil for nonexistent program")
+	}
+	// Не должна быть ошибкой контекста.
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("err should not be context error, got %v", err)
+	}
+	// ExitCode не должен быть заполнен при ошибке запуска.
+	if res.ExitCode != 0 {
+		t.Fatalf("ExitCode should be 0 for exec error, got %d", res.ExitCode)
+	}
+}
