 }
+
+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Minute)
+	var wg sync.WaitGroup
+
+	// Горутина для записи
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Set("key", "value")
+		}
+	}()
+
+	// Горутина для чтения
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Get("key")
+		}
+	}()
+
+	// Горутина для cleanup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		stop := c.StartCleanup(1 * time.Millisecond)
+		defer stop()
+		time.Sleep(50 * time.Millisecond)
+	}()
+
+	wg.Wait()
+}
