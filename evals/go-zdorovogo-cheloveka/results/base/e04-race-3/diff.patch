diff -ruN -x .git orig/cache_test.go ws/cache_test.go
--- orig/cache_test.go	2026-10-01 12:21:22.650193531 +0000
+++ ws/cache_test.go	2026-10-01 12:14:15.622437399 +0000
@@ -15,3 +15,39 @@
 		t.Fatal("Get(b) found missing key")
 	}
 }
+
+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Hour)
+	done := make(chan struct{})
+
+	// Start cleanup goroutine
+	stop := c.StartCleanup(time.Millisecond)
+	defer stop()
+
+	// Multiple writers
+	for i := 0; i < 3; i++ {
+		go func(idx int) {
+			for j := 0; j < 100; j++ {
+				c.Set("key", "value")
+			}
+			done <- struct{}{}
+		}(i)
+	}
+
+	// Multiple readers
+	for i := 0; i < 3; i++ {
+		go func(idx int) {
+			for j := 0; j < 100; j++ {
+				c.Get("key")
+				c.Len()
+				c.Snapshot()
+			}
+			done <- struct{}{}
+		}(i)
+	}
+
+	// Wait for all goroutines
+	for i := 0; i < 6; i++ {
+		<-done
+	}
+}
