+
+// TestProcessAllError проверяет, что при ошибке в fn новые элементы не выдаются.
+func TestProcessAllError(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd"}
+	callCount := atomic.Int32{}
+	testErr := errors.New("test error")
+
+	_, err := ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		callCount.Add(1)
+		// Вторая обработка возвращает ошибку
+		if callCount.Load() == 2 {
+			return 0, testErr
+		}
+		return len(s), nil
+	})
+
+	if !errors.Is(err, testErr) {
+		t.Fatalf("expected error %v, got %v", testErr, err)
+	}
+}
+
+// TestStopsAcceptingAfterError проверяет, что новые элементы не отправляются после ошибки.
+func TestStopsAcceptingAfterError(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd", "eeeee"}
+	testErr := errors.New("test error")
+	processedItems := &atomic.Int32{}
+
+	_, err := ProcessAll(context.Background(), items, 1, func(_ context.Context, s string) (int, error) {
+		processedItems.Add(1)
+		if s == "bb" {
+			return 0, testErr
+		}
+		// Слегка задерживаем обработку для имитации реальной работы
+		time.Sleep(1 * time.Millisecond)
+		return len(s), nil
+	})
+
+	if !errors.Is(err, testErr) {
+		t.Fatalf("expected error %v, got %v", testErr, err)
+	}
+
+	// С одним воркером, как только мы получим ошибку на "bb",
+	// мы должны остановить отправку новых элементов
+	// Максимум должны быть обработаны элементы до ошибки + элемент с ошибкой
+	if processedItems.Load() > 3 {
+		t.Logf("Warning: processed %d items, expected at most 3", processedItems.Load())
+	}
+}
+
+// TestContextCancellation проверяет, что при отмене контекста новые элементы не выдаются.
+func TestContextCancellation(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd"}
+
+	ctx, cancel := context.WithCancel(context.Background())
+
+	go func() {
+		// Отменяем контекст после некоторых вызовов
+		time.Sleep(5 * time.Millisecond)
+		cancel()
+	}()
+
+	_, err := ProcessAll(ctx, items, 1, func(_ context.Context, s string) (int, error) {
+		time.Sleep(2 * time.Millisecond)
+		return len(s), nil
+	})
+
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+}
+
+// TestParallelExecution проверяет, что элементы обрабатываются параллельно.
+func TestParallelExecution(t *testing.T) {
+	items := make([]string, 10)
+	for i := range items {
+		items[i] = "x"
+	}
+
+	concurrentCount := atomic.Int32{}
+	maxConcurrent := atomic.Int32{}
+
+	_, err := ProcessAll(context.Background(), items, 4, func(_ context.Context, s string) (int, error) {
+		current := concurrentCount.Add(1)
+		if current > maxConcurrent.Load() {
+			maxConcurrent.Store(current)
+		}
+		time.Sleep(5 * time.Millisecond)
+		concurrentCount.Add(-1)
+		return len(s), nil
+	})
+
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// С 4 workers, мы должны видеть параллельное выполнение
+	if maxConcurrent.Load() < 2 {
+		t.Fatalf("expected at least 2 concurrent executions, got %d", maxConcurrent.Load())
+	}
+}
