+// TestGetStatusContextCancellation проверяет, что GetStatus уважает отмену контекста.
+func TestGetStatusContextCancellation(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Имитируем долгий ответ
+		time.Sleep(100 * time.Millisecond)
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	_, err := c.GetStatus(ctx, "42")
+	if err == nil {
+		t.Fatal("ожидаю ошибку от контекста")
+	}
+	// Проверяем, что это ошибка отмены контекста
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("ожидаю context.DeadlineExceeded, получил %v", err)
+	}
+}
+
+// TestGetStatusNotFound проверяет, что 404 возвращает ErrNotFound.
+func TestGetStatusNotFound(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte(`{"error":"не найдено"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(context.Background(), "nonexistent")
+	if err == nil {
+		t.Fatal("ожидаю ошибку ErrNotFound")
+	}
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("ожидаю ErrNotFound, получил %v", err)
+	}
+}
+
+// TestGetStatusError проверяет, что другие статусы ошибок возвращают *StatusError.
+func TestGetStatusError(t *testing.T) {
+	tests := []int{
+		http.StatusInternalServerError,
+		http.StatusBadRequest,
+		http.StatusForbidden,
+		http.StatusServiceUnavailable,
+	}
+
+	for _, statusCode := range tests {
+		t.Run(http.StatusText(statusCode), func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(statusCode)
+				w.Write([]byte(`{"error":"ошибка"}`))
+			}))
+			defer srv.Close()
+
+			c := &Client{BaseURL: srv.URL}
+			_, err := c.GetStatus(context.Background(), "42")
+			if err == nil {
+				t.Fatal("ожидаю ошибку StatusError")
+			}
+			var statusErr *StatusError
+			if !errors.As(err, &statusErr) {
+				t.Fatalf("ожидаю *StatusError, получил %v", err)
+			}
+			if statusErr.Code != statusCode {
+				t.Fatalf("ожидаю код %d, получил %d", statusCode, statusErr.Code)
+			}
+		})
+	}
+}
+
+// TestGetStatusBodyClosed проверяет, что тело ответа закрывается (предотвращение утечек соединений).
+func TestGetStatusBodyClosed(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	// Выполняем много запросов подряд
+	for i := 0; i < 100; i++ {
+		_, err := c.GetStatus(context.Background(), "42")
+		if err != nil {
+			t.Fatalf("итерация %d: %v", i, err)
+		}
+	}
+	// Если соединения не закрывались, мы бы получили ошибку «too many open files»
+	// или другую ошибку о ресурсах. Успешное выполнение означает, что тела закрывались.
+}
