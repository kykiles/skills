+// Test reproducing the bug where multiple commands share arguments
+func TestProfileMultipleCommands(t *testing.T) {
+	profile := NewProfile()
+
+	// Build arguments for first command
+	cmd1Args := profile.Command("run", "first")
+
+	// Build arguments for second command
+	cmd2Args := profile.Command("run", "second")
+
+	// cmd1Args should have "first", not "second"
+	want1 := []string{"--quiet", "--color=never", "run", "first"}
+	want2 := []string{"--quiet", "--color=never", "run", "second"}
+
+	if !slices.Equal(cmd1Args, want1) {
+		t.Fatalf("cmd1Args = %q; want %q", cmd1Args, want1)
+	}
+	if !slices.Equal(cmd2Args, want2) {
+		t.Fatalf("cmd2Args = %q; want %q", cmd2Args, want2)
+	}
