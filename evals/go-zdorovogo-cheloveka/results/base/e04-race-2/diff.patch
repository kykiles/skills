diff -ruN -x .git orig/race_test.go ws/race_test.go
--- orig/race_test.go	1970-01-01 00:00:00.000000000 +0000
+++ ws/race_test.go	2026-10-01 12:11:23.766427183 +0000
@@ -0,0 +1,75 @@
+package ttlcache
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestConcurrentReadWrite(t *testing.T) {
+	c := New(time.Hour)
+	stop := c.StartCleanup(10 * time.Millisecond)
+	defer stop()
+
+	done := make(chan struct{})
+	var wg sync.WaitGroup
+
+	// Writer goroutine
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Set("key", "value")
+			select {
+			case <-done:
+				return
+			default:
+			}
+		}
+	}()
+
+	// Reader goroutine
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Get("key")
+			select {
+			case <-done:
+				return
+			default:
+			}
+		}
+	}()
+
+	// Len goroutine
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Len()
+			select {
+			case <-done:
+				return
+			default:
+			}
+		}
+	}()
+
+	// Snapshot goroutine
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			c.Snapshot()
+			select {
+			case <-done:
+				return
+			default:
+			}
+		}
+	}()
+
+	wg.Wait()
+	close(done)
+}
