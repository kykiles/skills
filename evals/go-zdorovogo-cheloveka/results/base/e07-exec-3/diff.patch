 // Run запускает программу name с аргументами args и ждёт её завершения.
+//
+// Аргументы передаются напрямую программе без интерпретации shell:
+// аргументы с пробелами, кавычками и специальными символами (;, $, *, и т.д.)
+// доходят до программы как есть.
+//
+// Результат содержит:
+//   - Stdout: весь вывод программы в stdout
+//   - Stderr: весь вывод программы в stderr
+//   - ExitCode: код выхода программы
+//
+// Run возвращает ошибку только если:
+//   - программу не удалось запустить (например, она не найдена)
+//   - контекст был отменён (для такой ошибки errors.Is(err, ctx.Err()) истинно)
+//
+// Ненулевой код выхода программы — не считается ошибкой Run;
+// код помещается в Result.ExitCode.
+//
+// При отмене контекста Run останавливает процесс и возвращает ошибку.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+
+	result := Result{
+		Stdout:   stdout.String(),
+		Stderr:   stderr.String(),
+		ExitCode: 0,
+	}
+
+	// Проверяем, отменён ли контекст
+	if ctx.Err() != nil {
+		return result, ctx.Err()
+	}
+
+	// Если есть ошибка, извлекаем код выхода если это ExitError
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			result.ExitCode = exitErr.ExitCode()
+			return result, nil
+		}
+		// Для других ошибок (программа не найдена и т.д.) возвращаем ошибку
+		return result, err
+	}
+
+	return result, nil
 }
