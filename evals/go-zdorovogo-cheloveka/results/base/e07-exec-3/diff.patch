+// TestNonZeroExitCode проверяет, что ненулевой код выхода не считается ошибкой
+func TestNonZeroExitCode(t *testing.T) {
+	// Используем `false` что возвращает код выхода 1
+	res, err := Run(context.Background(), "false")
+	if err != nil {
+		t.Fatalf("Expected no error, but got: %v", err)
+	}
+	if res.ExitCode != 1 {
+		t.Fatalf("ExitCode = %d, want 1", res.ExitCode)
+	}
+}
+
+// TestExitCodePreservation проверяет что различные коды выхода правильно сохраняются
+func TestExitCodePreservation(t *testing.T) {
+	testCases := []struct {
+		name     string
+		cmd      string
+		wantCode int
+	}{
+		{"exit 0", "exit 0", 0},
+		{"exit 1", "exit 1", 1},
+		{"exit 42", "exit 42", 42},
+	}
+
+	for _, tc := range testCases {
+		t.Run(tc.name, func(t *testing.T) {
+			res, err := Run(context.Background(), "bash", "-c", tc.cmd)
+			if err != nil {
+				t.Fatalf("Expected no error, but got: %v", err)
+			}
+			if res.ExitCode != tc.wantCode {
+				t.Fatalf("ExitCode = %d, want %d", res.ExitCode, tc.wantCode)
+			}
+		})
+	}
+}
+
+// TestContextCancellation проверяет, что отмена контекста останавливает программу
+func TestContextCancellation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	// Используем `sleep 10` которая будет остановлена
+	res, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatalf("Expected error due to context cancellation, got nil")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Expected context.DeadlineExceeded, got: %v", err)
+	}
+	// Проверяем что код выхода 0 (процесс был убит, не завершился с ошибкой)
+	if res.ExitCode != 0 {
+		t.Logf("Note: ExitCode = %d after cancellation", res.ExitCode)
+	}
+}
+
+// TestProgramNotFound проверяет, что ошибка возвращается если программа не найдена
+func TestProgramNotFound(t *testing.T) {
+	res, err := Run(context.Background(), "nonexistent_program_12345", "arg1")
+	if err == nil {
+		t.Fatalf("Expected error for nonexistent program, got nil")
+	}
+	// Должна быть ошибка, не просто код выхода
+	if res.ExitCode != 0 {
+		t.Logf("Note: ExitCode = %d for nonexistent program", res.ExitCode)
+	}
