+// TestArgumentsWithSpaces проверяет, что аргументы с пробелами передаются как есть
+func TestArgumentsWithSpaces(t *testing.T) {
+	res, err := Run(context.Background(), "echo", "hello world", "foo bar")
+	if err != nil {
+		t.Fatal(err)
+	}
+	output := strings.TrimSpace(res.Stdout)
+	if !strings.Contains(output, "hello world") || !strings.Contains(output, "foo bar") {
+		t.Fatalf("Expected arguments with spaces, got: %q", output)
+	}
+}
+
+// TestArgumentsWithSpecialCharacters проверяет, что специальные символы не интерпретируются shell
+func TestArgumentsWithSpecialCharacters(t *testing.T) {
+	// Тестируем аргумент с `;`, `$`, `*`
+	res, err := Run(context.Background(), "echo", "test;value", "$HOME", "*.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	output := strings.TrimSpace(res.Stdout)
+	// Проверяем, что аргументы не интерпретированы как shell команды
+	if !strings.Contains(output, "test;value") || !strings.Contains(output, "$HOME") || !strings.Contains(output, "*.txt") {
+		t.Fatalf("Special characters not preserved: %q", output)
+	}
+	// Убедимся, что $HOME не был подставлен (если это произошло бы в shell)
+	if strings.Contains(output, "/home/") || strings.Contains(output, "/root") {
+		t.Fatalf("$HOME was expanded, should be literal: %q", output)
+	}
+}
+
+// TestStdoutStderr проверяет, что stdout и stderr разделены
+func TestStdoutStderr(t *testing.T) {
+	// Используем printf для более точного контроля
+	res, err := Run(context.Background(), "bash", "-c", "echo 'to stdout'; echo 'to stderr' >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout := strings.TrimSpace(res.Stdout)
+	stderr := strings.TrimSpace(res.Stderr)
+	if stdout != "to stdout" {
+		t.Fatalf("Stdout = %q, want 'to stdout'", stdout)
+	}
+	if stderr != "to stderr" {
+		t.Fatalf("Stderr = %q, want 'to stderr'", stderr)
+	}
+}
