@@ -1,6 +1,8 @@
 package svcconfig
 
 import (
+	"errors"
+	"io/fs"
 	"os"
 	"path/filepath"
 	"testing"
@@ -16,3 +18,82 @@
 		t.Fatalf("Load() = %v, %v; want nil config and error", cfg, err)
