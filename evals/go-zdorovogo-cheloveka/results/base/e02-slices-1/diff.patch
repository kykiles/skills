 // Build возвращает base, за которыми следуют extra.
 // base не изменяется.
 func Build(base []string, extra ...string) []string {
-	return append(base, extra...)
+	result := make([]string, len(base), len(base)+len(extra))
+	copy(result, base)
+	return append(result, extra...)
 }
 
