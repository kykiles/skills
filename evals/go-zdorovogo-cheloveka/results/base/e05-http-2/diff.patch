--- orig/client.go	2026-10-01 12:21:10.863463967 +0000
+++ ws/client.go	2026-10-01 12:10:50.690425217 +0000
@@ -45,13 +45,26 @@
 // Для ответа 404 возвращает ErrNotFound, для остальных статусов, кроме 200, —
 // *StatusError. Учитывает отмену и дедлайн ctx.
 func (c *Client) GetStatus(ctx context.Context, id string) (Status, error) {
-	resp, err := c.httpClient().Get(c.BaseURL + "/v1/status/" + url.PathEscape(id))
+	req, err := http.NewRequestWithContext(ctx, "GET", c.BaseURL+"/v1/status/"+url.PathEscape(id), nil)
 	if err != nil {
 		return Status{}, err
 	}
-	var st Status
-	if err := json.NewDecoder(resp.Body).Decode(&st); err != nil {
-		return Status{}, fmt.Errorf("statusapi: разбор ответа: %w", err)
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return Status{}, err
+	}
+	defer resp.Body.Close()
+
+	switch resp.StatusCode {
+	case http.StatusOK:
+		var st Status
+		if err := json.NewDecoder(resp.Body).Decode(&st); err != nil {
+			return Status{}, fmt.Errorf("statusapi: разбор ответа: %w", err)
+		}
+		return st, nil
+	case http.StatusNotFound:
+		return Status{}, ErrNotFound
+	default:
+		return Status{}, &StatusError{Code: resp.StatusCode}
 	}
-	return st, nil
 }
