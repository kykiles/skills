+// TestGetStatusNotFound проверяет, что 404 возвращает ErrNotFound.
+func TestGetStatusNotFound(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte(`{}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(context.Background(), "nonexistent")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("ожидалась ErrNotFound, получена %v", err)
+	}
+}
+
+// TestGetStatusOtherError проверяет, что другие ошибки возвращают StatusError.
+func TestGetStatusOtherError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte(`{}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(context.Background(), "42")
+	var statusErr *StatusError
+	if !errors.As(err, &statusErr) {
+		t.Fatalf("ожидалась *StatusError, получена %v", err)
+	}
+	if statusErr.Code != http.StatusInternalServerError {
+		t.Fatalf("ожидалась 500, получена %d", statusErr.Code)
+	}
+}
+
+// TestGetStatusContextCancellation проверяет, что GetStatus реагирует на отмену контекста.
+func TestGetStatusContextCancellation(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Имитируем долгую обработку
+		time.Sleep(100 * time.Millisecond)
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	c := &Client{BaseURL: srv.URL}
+	_, err := c.GetStatus(ctx, "42")
+	if err == nil {
+		t.Fatal("ожидалась ошибка отмены контекста")
+	}
+	// Проверяем, что это ошибка контекста
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("ожидалась context.DeadlineExceeded, получена %v", err)
+	}
+}
+
+// TestGetStatusConnectionClosed проверяет, что соединение закрывается после запроса.
+func TestGetStatusConnectionClosed(t *testing.T) {
+	requestCount := 0
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestCount++
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+
+	// Выполняем несколько запросов
+	for i := 0; i < 10; i++ {
+		_, err := c.GetStatus(context.Background(), "42")
+		if err != nil {
+			t.Fatalf("запрос %d: %v", i, err)
+		}
+	}
+
+	if requestCount != 10 {
+		t.Fatalf("ожидалось 10 запросов, получено %d", requestCount)
+	}
+}
