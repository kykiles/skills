+
+// TestLoadValidConfig проверяет загрузку корректной конфигурации
+func TestLoadValidConfig(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	if err := os.WriteFile(path, []byte(`{"addr": "0.0.0.0", "port": 9000, "log_level": "debug"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := Load(path)
+	if err != nil {
+		t.Fatalf("Load() returned error: %v", err)
+	}
+	if cfg == nil {
+		t.Fatal("Load() returned nil config")
+	}
+	if cfg.Addr != "0.0.0.0" || cfg.Port != 9000 || cfg.LogLevel != "debug" {
+		t.Fatalf("Load() returned incorrect config: %+v", cfg)
+	}
+}
+
+// TestLoadMissingFile проверяет обработку отсутствующего файла
+func TestLoadMissingFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "nonexistent.json")
+	cfg, err := Load(path)
+	if cfg != nil {
+		t.Fatalf("Load() should return nil config for missing file, got %+v", cfg)
+	}
+	if err == nil {
+		t.Fatal("Load() should return error for missing file")
+	}
+	// Проверяем, что ошибка может быть обнаружена с помощью errors.Is
+	if !errors.Is(err, fs.ErrNotExist) {
+		t.Fatalf("Load() should wrap fs.ErrNotExist, got: %v", err)
+	}
+}
+
+// TestLoadValidationError проверяет обработку ошибок валидации
+func TestLoadValidationError(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	// Неправильный порт
+	if err := os.WriteFile(path, []byte(`{"port": 99999}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := Load(path)
+	if cfg != nil {
+		t.Fatalf("Load() should return nil config on validation error, got %+v", cfg)
+	}
+	if err == nil {
+		t.Fatal("Load() should return error on validation error")
+	}
+}
