+// TestCountMatchesLargeLines проверяет корректность работы со строками > 64KB
+func TestCountMatchesLargeLines(t *testing.T) {
+	dir := t.TempDir()
+	p := filepath.Join(dir, "large.log")
+
+	// Создаём файл со строками размером > 64KB
+	var buf bytes.Buffer
+	largeString := strings.Repeat("x", 100*1024) // 100KB строка
+	buf.WriteString("error " + largeString + "\n")
+	buf.WriteString("ok line\n")
+	buf.WriteString("error " + largeString + "\n")
+
+	if err := os.WriteFile(p, buf.Bytes(), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	got, err := CountMatches([]string{p}, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	if got[p] != 2 {
+		t.Fatalf("CountMatches = %v; want 2 (got %d)", got, got[p])
+	}
+}
+
+// TestCountMatchesManyFiles проверяет, что файлы правильно закрываются
+func TestCountMatchesManyFiles(t *testing.T) {
+	dir := t.TempDir()
+
+	// Создаём 150 файлов
+	paths := make([]string, 150)
+	for i := 0; i < 150; i++ {
+		filename := fmt.Sprintf("file%03d.log", i)
+		p := filepath.Join(dir, filename)
+		paths[i] = p
+		content := "error log\nok\nerror\n"
+		if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	got, err := CountMatches(paths, "error")
+	if err != nil {
+		t.Fatalf("CountMatches failed: %v", err)
+	}
+
+	if len(got) != 150 {
+		t.Fatalf("Expected 150 results, got %d", len(got))
+	}
+
+	// Каждый файл должен иметь 2 совпадения "error"
+	for _, p := range paths {
+		if got[p] != 2 {
+			t.Fatalf("File %s: got %d, want 2", p, got[p])
+		}
+	}
+}
