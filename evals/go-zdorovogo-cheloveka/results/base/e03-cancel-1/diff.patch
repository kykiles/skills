+// TestNoGoroutineLeakOnError проверяет, что горутины не протекают при ошибке
+func TestNoGoroutineLeakOnError(t *testing.T) {
+	initialGoroutines := runtime.NumGoroutine()
+
+	_, _ = ProcessAll(context.Background(), []string{"a", "b", "c"}, 2, func(_ context.Context, s string) (int, error) {
+		if s == "b" {
+			return 0, errors.New("test error")
+		}
+		return len(s), nil
+	})
+
+	// Дождаться очистки горутин
+	time.Sleep(100 * time.Millisecond)
+
+	finalGoroutines := runtime.NumGoroutine()
+	if finalGoroutines > initialGoroutines {
+		t.Fatalf("goroutine leak: started with %d, ended with %d", initialGoroutines, finalGoroutines)
+	}
+}
+
+// TestNoGoroutineLeakOnCancellation проверяет, что ProcessAll дожидается завершения всех горутин при отмене
+func TestNoGoroutineLeakOnCancellation(t *testing.T) {
+	// Проверим, что все горутины завершают работу корректно при отмене контекста
+	ctx, cancel := context.WithCancel(context.Background())
+	var wg sync.WaitGroup
+	var allClosed bool
+
+	// Горутина, которая отменит контекст через некоторое время
+	go func() {
+		time.Sleep(30 * time.Millisecond)
+		cancel()
+	}()
+
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		_, _ = ProcessAll(ctx, []string{"a", "b", "c", "d", "e"}, 2, func(_ context.Context, s string) (int, error) {
+			time.Sleep(10 * time.Millisecond)
+			return len(s), nil
+		})
+		allClosed = true
+	}()
+
+	// Дождаться завершения ProcessAll
+	done := make(chan struct{})
+	go func() {
+		wg.Wait()
+		close(done)
+	}()
+
+	select {
+	case <-done:
+		// ProcessAll завершилась корректно
+	case <-time.After(5 * time.Second):
+		t.Fatal("ProcessAll not completed within 5 seconds - possible goroutine leak")
+	}
+
+	if !allClosed {
+		t.Fatal("ProcessAll did not complete")
+	}
+}
+
+// TestProcessAllCompletes проверяет, что функция дождётся завершения всех горутин
+func TestProcessAllCompletes(t *testing.T) {
+	var mu sync.Mutex
+	var completed []string
+	numItems := 10
+
+	_, _ = ProcessAll(context.Background(), generateItems(numItems), 3, func(_ context.Context, s string) (int, error) {
+		if s == "item5" {
+			return 0, errors.New("test error at item5")
+		}
+		mu.Lock()
+		completed = append(completed, s)
+		mu.Unlock()
+		return len(s), nil
+	})
+
+	// ProcessAll должна дождаться завершения всех уже начатых горутин
+	// Проверим, что завершено нечетное число элементов (некоторые могут быть в процессе)
+	if len(completed) == 0 {
+		t.Fatalf("expected at least some items to complete")
+	}
+}
+
+func generateItems(n int) []string {
+	items := make([]string, n)
+	for i := 0; i < n; i++ {
+		items[i] = fmt.Sprintf("item%d", i)
+	}
+	return items
+}
