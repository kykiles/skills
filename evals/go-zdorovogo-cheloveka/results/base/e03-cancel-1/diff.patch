+// TestProcessAllError проверяет, что при ошибке в fn:
+// 1. Новые элементы перестают передаваться
+// 2. Горутины завершаются корректно (нет утечки)
+// 3. fn не вызывается после первой ошибки
+func TestProcessAllError(t *testing.T) {
+	var mu sync.Mutex
+	callCount := 0
+	errorAt := 3
+
+	got, err := ProcessAll(context.Background(), []string{"a", "b", "c", "d", "e"}, 2, func(_ context.Context, s string) (int, error) {
+		mu.Lock()
+		callCount++
+		current := callCount
+		mu.Unlock()
+
+		if current == errorAt {
+			return 0, errors.New("test error")
+		}
+		return len(s), nil
+	})
+
+	if err == nil || err.Error() != "test error" {
+		t.Fatalf("expected 'test error', got %v", err)
+	}
+	if got != nil {
+		t.Fatalf("expected nil results on error, got %v", got)
+	}
+
+	// Дождаться завершения всех горутин
+	time.Sleep(100 * time.Millisecond)
+
+	// callCount не должен расти больше определённого значения
+	// Может быть некоторые горутины уже работают, поэтому разрешим некоторый запас
+	if callCount > errorAt+2 {
+		t.Fatalf("too many fn calls after error: %d (expected at most %d)", callCount, errorAt+2)
+	}
+}
+
+// TestProcessAllContextCancellation проверяет, что при отмене контекста:
+// 1. Новые элементы перестают передаваться
+// 2. Горутины завершаются корректно (нет утечки)
+// 3. Возвращается ctx.Err() или ошибка обработана
+func TestProcessAllContextCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	var mu sync.Mutex
+	callCount := 0
+
+	go func() {
+		time.Sleep(30 * time.Millisecond)
+		cancel()
+	}()
+
+	// Используем много элементов и медленную обработку
+	got, err := ProcessAll(ctx, generateItems(20), 2, func(_ context.Context, s string) (int, error) {
+		mu.Lock()
+		callCount++
+		mu.Unlock()
+		time.Sleep(20 * time.Millisecond)
+		return len(s), nil
+	})
+
+	// При отмене контекста либо вернётся ctx.Canceled, либо обработка завершится раньше
+	if err != nil && err != context.Canceled {
+		t.Fatalf("expected context.Canceled or nil, got %v", err)
+	}
+	if err == context.Canceled && got != nil {
+		t.Fatalf("expected nil results on context cancellation, got %v", got)
+	}
+
+	// Проверим, что не все элементы обработаны (отмена произошла)
+	if callCount == 20 && err == nil {
+		t.Fatalf("expected cancellation, but all items were processed")
+	}
+}
