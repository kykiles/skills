diff -ruN -x .git orig/cmdargs.go ws/cmdargs.go
--- orig/cmdargs.go	2026-10-01 12:21:18.642083259 +0000
+++ ws/cmdargs.go	2026-10-01 12:14:18.922437595 +0000
@@ -4,7 +4,10 @@
 // Build возвращает base, за которыми следуют extra.
 // base не изменяется.
 func Build(base []string, extra ...string) []string {
-	return append(base, extra...)
+	result := make([]string, 0, len(base)+len(extra))
+	result = append(result, base...)
+	result = append(result, extra...)
+	return result
 }
 
