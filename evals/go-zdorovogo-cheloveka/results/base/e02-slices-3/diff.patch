+
+func TestProfileMultipleCommands(t *testing.T) {
+	// Тест проверяет что несколько команд с одним профилем работают независимо
+	profile := NewProfile()
+
+	cmd1 := profile.Command("run", "test1")
+	cmd2 := profile.Command("build", "test2")
+
+	want1 := []string{"--quiet", "--color=never", "run", "test1"}
+	want2 := []string{"--quiet", "--color=never", "build", "test2"}
+
+	if !slices.Equal(cmd1, want1) {
+		t.Errorf("First command = %q; want %q", cmd1, want1)
+	}
+	if !slices.Equal(cmd2, want2) {
+		t.Errorf("Second command = %q; want %q", cmd2, want2)
+	}
+
+	// Проверяем что первая команда не была изменена
+	if !slices.Equal(cmd1, want1) {
+		t.Errorf("First command was modified = %q; want %q", cmd1, want1)
+	}
+}
