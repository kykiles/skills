 // Result — итог работы программы.
@@ -16,11 +15,49 @@
 }
 
 // Run запускает программу name с аргументами args и ждёт её завершения.
+// Аргументы передаются программе как есть, без интерпретации оболочкой.
+// Любые символы (пробелы, кавычки, $, *, ; и т.д.) доходят до программы без изменения.
+//
+// Результат содержит:
+//   - Stdout: вывод программы в stdout
+//   - Stderr: вывод программы в stderr
+//   - ExitCode: код выхода программы (0 при успехе, ненулевой при ошибке)
+//
+// Ошибка возвращается только если:
+//   - программу не удалось запустить (программа не найдена и т.д.)
+//   - программа была прервана отменой контекста (errors.Is(err, ctx.Err()) будет true)
+// Ненулевой код выхода программы не является ошибкой Run.
+//
+// Если ctx отменяется, программа останавливается и Run возвращает ошибку.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+
+	exitCode := 0
+	if err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			// Если контекст отменён, возвращаем ошибку контекста вместо ExitError
+			if ctx.Err() != nil {
+				err = ctx.Err()
+			} else {
+				// Иначе ненулевой код выхода не является ошибкой
+				exitCode = exitErr.ExitCode()
+				err = nil
+			}
+		} else if ctx.Err() != nil {
+			// Если это не ExitError, но контекст отменён, вернуть ошибку контекста
+			err = ctx.Err()
+		}
+		// Другие ошибки (не удалось запустить программу) остаются как есть
+	}
+
+	return Result{
+		Stdout:   stdout.String(),
+		Stderr:   stderr.String(),
+		ExitCode: exitCode,
+	}, err
 }
