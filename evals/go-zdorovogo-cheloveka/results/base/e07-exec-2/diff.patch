+
+// TestRunArgumentsWithSpaces проверяет, что аргументы с пробелами передаются правильно
+func TestRunArgumentsWithSpaces(t *testing.T) {
+	res, err := Run(context.Background(), "echo", "hello world")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.TrimSpace(res.Stdout) != "hello world" {
+		t.Fatalf("Expected 'hello world', got %q", res.Stdout)
+	}
+}
+
+// TestRunArgumentsWithQuotes проверяет, что кавычки передаются как есть
+func TestRunArgumentsWithQuotes(t *testing.T) {
+	res, err := Run(context.Background(), "printf", "%s", `"quoted"`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != `"quoted"` {
+		t.Fatalf("Expected '\"quoted\"', got %q", res.Stdout)
+	}
+}
+
+// TestRunArgumentsWithSpecialChars проверяет, что спецсимволы передаются как есть
+func TestRunArgumentsWithSpecialChars(t *testing.T) {
+	res, err := Run(context.Background(), "printf", "%s", "$PATH;*$(echo)")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Stdout != "$PATH;*$(echo)" {
+		t.Fatalf("Expected '$PATH;*$(echo)', got %q", res.Stdout)
+	}
+}
+
+// TestRunStdoutStderr проверяет, что stdout и stderr разделены
+func TestRunStdoutStderr(t *testing.T) {
+	// Используем /bin/sh для вывода в stderr
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout; echo stderr >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if !strings.Contains(res.Stdout, "stdout") {
+		t.Fatalf("Stdout should contain 'stdout', got %q", res.Stdout)
+	}
+	if !strings.Contains(res.Stderr, "stderr") {
+		t.Fatalf("Stderr should contain 'stderr', got %q", res.Stderr)
+	}
+}
+
+// TestRunExitCode проверяет, что ненулевой код выхода не является ошибкой
+func TestRunExitCode(t *testing.T) {
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatalf("Expected no error, got %v", err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("Expected exit code 42, got %d", res.ExitCode)
+	}
+}
+
+// TestRunNotFound проверяет, что ошибка возвращается если программа не найдена
+func TestRunNotFound(t *testing.T) {
+	res, err := Run(context.Background(), "nonexistent-command-xyz", "arg")
+	if err == nil {
+		t.Fatal("Expected error for nonexistent command")
+	}
+	// ExitCode должен быть 0 если программа не запустилась
+	if res.ExitCode != 0 {
+		t.Fatalf("Expected exit code 0, got %d", res.ExitCode)
+	}
+}
+
+// TestRunContextCancellation проверяет, что программа останавливается при отмене контекста
+func TestRunContextCancellation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	// Используем sleep, который будет прерван
+	_, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatal("Expected error due to context cancellation")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Expected context.DeadlineExceeded, got %v", err)
+	}
+}
