+// formatSection форматирует одну секцию отчёта по уровню.
+// displayMessages определяет, выводить ли текст сообщений (для Critical/Warning)
+// или только их количество (для Info).
+func formatSection(b *strings.Builder, level Level, entries map[string][]Entry, displayMessages bool) {
+	if len(entries) == 0 {
+		return
+	}
+
+	b.WriteString("\n[" + level.String() + "]\n")
+
+	var sources []string
+	for s := range entries {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		seen := map[string]bool{}
+		var msgs []string
+
+		for _, e := range entries[s] {
+			n += e.Count
+			if !seen[e.Message] {
+				seen[e.Message] = true
+				if displayMessages {
+					msgs = append(msgs, e.Message)
+				}
+			}
+		}
+
+		total += n
+
+		if displayMessages {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, strings.Join(msgs, "; ")))
+		} else {
+			b.WriteString(fmt.Sprintf("  %-12s %5d  (%d сообщ.)\n", s, n, len(seen)))
+		}
+	}
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+}
