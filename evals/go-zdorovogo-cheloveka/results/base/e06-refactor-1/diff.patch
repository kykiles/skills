+// messageFormatter форматирует сообщения для одного источника.
+// Параметры: список уникальных сообщений и их количество.
+type messageFormatter func(msgs []string, uniqueCount int) string
+
+// formatMessageSection форматирует одну секцию отчёта по уровню.
+func formatMessageSection(levelStr string, section map[string][]Entry, formatter messageFormatter) string {
+	if len(section) == 0 {
+		return ""
+	}
+
+	var b strings.Builder
+	b.WriteString("\n[" + levelStr + "]\n")
+
+	var sources []string
+	for s := range section {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		var msgs []string
+		seen := map[string]bool{}
+		for _, e := range section[s] {
+			n += e.Count
+			if !seen[e.Message] {
+				seen[e.Message] = true
+				msgs = append(msgs, e.Message)
+			}
+		}
+		total += n
+		b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, formatter(msgs, len(seen))))
+	}
+
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+	return b.String()
+}
