+func TestFormatReportComplex(t *testing.T) {
+	// Тест с дублированием сообщений на разных уровнях
+	got := FormatReport("тест", []Entry{
+		{Source: "db", Level: Critical, Message: "disk full", Count: 2},
+		{Source: "db", Level: Critical, Message: "connection lost", Count: 1},
+		{Source: "api", Level: Warning, Message: "high latency", Count: 3},
+		{Source: "cache", Level: Warning, Message: "high latency", Count: 1},
+		{Source: "web", Level: Info, Message: "restart", Count: 5},
+		{Source: "web", Level: Info, Message: "restart", Count: 2}, // дублирование того же сообщения
+		{Source: "web", Level: Info, Message: "update", Count: 1},
+		{Source: "db", Level: Info, Message: "backup", Count: 3},
+	})
+
+	// Проверяем основные части вывода
+	if got[:len("=== тест ===")] != "=== тест ===" {
+		t.Errorf("Title line missing or incorrect")
+	}
+
+	// Проверяем наличие всех секций
+	if !contains(got, "[Critical]") {
+		t.Error("Missing Critical section")
+	}
+	if !contains(got, "[Warning]") {
+		t.Error("Missing Warning section")
+	}
+	if !contains(got, "[Info]") {
+		t.Error("Missing Info section")
+	}
+
+	// Проверяем форматирование Critical: два сообщения для db
+	if !contains(got, "disk full; connection lost") {
+		t.Errorf("Critical messages not formatted correctly. Got:\n%s", got)
+	}
+
+	// Проверяем форматирование Info: количество уникальных сообщений (2 для web, 1 для db)
+	if !contains(got, "(2 сообщ.)") && !contains(got, "(1 сообщ.)") {
+		t.Errorf("Info message count formatting incorrect. Got:\n%s", got)
+	}
+
+	// Проверяем итоговое количество событий: 3 + 4 + 11 = 18
+	if !contains(got, "всего событий: 18") {
+		t.Errorf("Total count incorrect. Got:\n%s", got)
+	}
+}
+
+func contains(s, substr string) bool {
+	for i := 0; i <= len(s)-len(substr); i++ {
+		if s[i:i+len(substr)] == substr {
+			return true
+		}
+	}
+	return false
+}
