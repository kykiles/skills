 	"os/exec"
-	"strings"
 )
 
 // Result — итог работы программы.
@@ -16,11 +16,38 @@
 }
 
 // Run запускает программу name с аргументами args и ждёт её завершения.
+// Ненулевой код выхода помещается в Result.ExitCode и не считается ошибкой;
+// ошибка возвращается только если программу не удалось запустить или её прервали контекстом.
+// При отмене контекста Run останавливает программу и возвращает ошибку, для которой errors.Is(err, ctx.Err()) истинно.
+// Аргументы передаются программе как есть, без интерпретации скорлупой.
 func Run(ctx context.Context, name string, args ...string) (Result, error) {
-	cmd := exec.Command("sh", "-c", name+" "+strings.Join(args, " "))
-	var out bytes.Buffer
-	cmd.Stdout = &out
-	cmd.Stderr = &out
+	cmd := exec.CommandContext(ctx, name, args...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
 	err := cmd.Run()
-	return Result{Stdout: out.String()}, err
+
+	result := Result{
+		Stdout: stdout.String(),
+		Stderr: stderr.String(),
+	}
+
+	// Если контекст отменён, вернуть его ошибку
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		return result, ctxErr
+	}
+
+	// Если процесс завершился с ненулевым кодом, извлечь и сохранить код
+	var exitErr *exec.ExitError
+	if errors.As(err, &exitErr) {
+		result.ExitCode = exitErr.ExitCode()
+		return result, nil
+	}
+
+	// Если другая ошибка (например, программу не нашли), вернуть её
+	if err != nil {
+		return result, err
+	}
+
+	return result, nil
 }
