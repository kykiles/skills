 }
+
+func TestRunArgumentsPreserved(t *testing.T) {
+	// Аргументы с пробелами, кавычками и спецсимволами должны доходить как есть
+	res, err := Run(context.Background(), "echo", "hello world", "with;semicolon", "with$dollar")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(res.Stdout, "hello world") {
+		t.Fatalf("Arguments not preserved: got %q", res.Stdout)
+	}
+}
+
+func TestRunSeparateStderr(t *testing.T) {
+	// stdout и stderr должны быть отдельно
+	// На POSIX-системах "echo" выводит в stdout, ">&2" перенаправляет в stderr
+	res, err := Run(context.Background(), "sh", "-c", "echo stdout; echo stderr >&2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(res.Stdout, "stdout") {
+		t.Fatalf("Stdout missing: got %q", res.Stdout)
+	}
+	if !strings.Contains(res.Stderr, "stderr") {
+		t.Fatalf("Stderr missing: got %q", res.Stderr)
+	}
+}
+
+func TestRunExitCode(t *testing.T) {
+	// Ненулевой код выхода не ошибка
+	res, err := Run(context.Background(), "sh", "-c", "exit 42")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.ExitCode != 42 {
+		t.Fatalf("ExitCode = %d, want 42", res.ExitCode)
+	}
+}
+
+func TestRunContextCancellation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+
+	res, err := Run(ctx, "sleep", "10")
+	if err == nil {
+		t.Fatal("Expected error due to context cancellation")
+	}
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("Expected context.DeadlineExceeded, got %v", err)
+	}
+	// Результат должен быть частично заполнен
+	if res.Stdout != "" && res.Stderr != "" {
+		t.Logf("Result was partially filled (OK): stdout=%q, stderr=%q", res.Stdout, res.Stderr)
+	}
+}
+
+func TestRunNotFound(t *testing.T) {
+	// Если программу не нашли - ошибка
+	res, err := Run(context.Background(), "nonexistent_program_12345", "arg")
+	if err == nil {
+		t.Fatal("Expected error for nonexistent program")
+	}
+	// ExitCode не должен быть установлен при ошибке запуска
+	if res.ExitCode != 0 {
+		t.Logf("ExitCode = %d (may vary by platform)", res.ExitCode)
+	}
+}
