-	resp, err := c.httpClient().Get(c.BaseURL + "/v1/status/" + url.PathEscape(id))
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.BaseURL+"/v1/status/"+url.PathEscape(id), nil)
 	if err != nil {
 		return Status{}, err
 	}
+	resp, err := c.httpClient().Do(req)
+	if err != nil {
+		return Status{}, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode == http.StatusNotFound {
+		// Дочитываем немного тела, чтобы соединение могло вернуться в пул.
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 4<<10))
+		return Status{}, ErrNotFound
+	}
+	if resp.StatusCode != http.StatusOK {
+		// Дочитываем немного тела, чтобы соединение могло вернуться в пул.
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 4<<10))
+		return Status{}, &StatusError{Code: resp.StatusCode}
+	}
+
