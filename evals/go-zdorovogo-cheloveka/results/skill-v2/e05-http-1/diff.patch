+
+func TestGetStatusNotFound(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		w.Write([]byte(`{"error":"not found"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(context.Background(), "nonexistent")
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("GetStatus for 404: want ErrNotFound, got %v", err)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus for 404: want zero Status, got %+v", st)
+	}
+}
+
+func TestGetStatusError(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+		w.Write([]byte(`{"error":"internal error"}`))
+	}))
+	defer srv.Close()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(context.Background(), "42")
+
+	var se *StatusError
+	if !errors.As(err, &se) {
+		t.Fatalf("GetStatus for 500: want *StatusError, got %v", err)
+	}
+	if se.Code != http.StatusInternalServerError {
+		t.Fatalf("StatusError.Code: want %d, got %d", http.StatusInternalServerError, se.Code)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus for 500: want zero Status, got %+v", st)
+	}
+}
+
+func TestGetStatusContextCancellation(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// Simulate slow response
+		time.Sleep(100 * time.Millisecond)
+		w.Write([]byte(`{"id":"42","state":"done"}`))
+	}))
+	defer srv.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+
+	c := &Client{BaseURL: srv.URL}
+	st, err := c.GetStatus(ctx, "42")
+
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("GetStatus with deadline: want context.DeadlineExceeded, got %v", err)
+	}
+	if st != (Status{}) {
+		t.Fatalf("GetStatus with deadline: want zero Status, got %+v", st)
+	}
+}
