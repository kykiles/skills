+// formatSection форматирует одну секцию отчёта для заданного уровня.
+// msgFormatter получает список Entry для источника и возвращает отформатированную строку сообщений.
+func formatSection(b *strings.Builder, level Level, entries map[string][]Entry, msgFormatter func([]Entry) string) {
+	if len(entries) == 0 {
+		return
+	}
+
+	b.WriteString("\n[" + level.String() + "]\n")
+	var sources []string
+	for s := range entries {
+		sources = append(sources, s)
+	}
+	sort.Strings(sources)
+
+	total := 0
+	for _, s := range sources {
+		n := 0
+		for _, e := range entries[s] {
+			n += e.Count
+		}
+		total += n
+		msgStr := msgFormatter(entries[s])
+		b.WriteString(fmt.Sprintf("  %-12s %5d  %s\n", s, n, msgStr))
+	}
+	b.WriteString(fmt.Sprintf("  итого: %d\n", total))
+}
