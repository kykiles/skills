+// formatMessages возвращает список уникальных сообщений, разделённых "; ".
+func formatMessages(entries []Entry) string {
+	var msgs []string
+	seen := map[string]bool{}
+	for _, e := range entries {
+		if !seen[e.Message] {
+			seen[e.Message] = true
+			msgs = append(msgs, e.Message)
+		}
+	}
+	return strings.Join(msgs, "; ")
+}
+
+// formatMessageCount возвращает количество уникальных сообщений в формате "(n сообщ.)".
+func formatMessageCount(entries []Entry) string {
+	seen := map[string]bool{}
+	for _, e := range entries {
+		seen[e.Message] = true
+	}
+	return fmt.Sprintf("(%d сообщ.)", len(seen))
