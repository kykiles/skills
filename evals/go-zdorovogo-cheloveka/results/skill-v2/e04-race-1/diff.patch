+func TestConcurrentAccess(t *testing.T) {
+	c := New(time.Minute)
+	var wg sync.WaitGroup
+
+	// 10 горутин пишут и читают одновременно
+	for i := 0; i < 10; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				c.Set("key", "value")
+				c.Get("key")
+				c.Len()
+			}
+		}(i)
+	}
+	wg.Wait()
