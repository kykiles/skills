+// TestProcessAllErrorStopsProcessing verifies that when fn returns an error,
+// ProcessAll stops processing and doesn't return partial results.
+func TestProcessAllErrorStopsProcessing(t *testing.T) {
+	items := []string{"a", "bb", "ccc", "dddd"}
+	errMsg := errors.New("test error")
+	var callCount atomic.Int32
+
+	_, err := ProcessAll(context.Background(), items, 2, func(_ context.Context, s string) (int, error) {
+		callCount.Add(1)
+		if callCount.Load() == 2 {
+			return 0, errMsg
+		}
+		return len(s), nil
+	})
+
+	if err != errMsg {
+		t.Fatalf("expected error %v, got %v", errMsg, err)
+	}
+}
+
+// TestProcessAllNoGoroutineLeakOnError checks that goroutines don't leak
+// after an error occurs. We count goroutines before and after.
+func TestProcessAllNoGoroutineLeakOnError(t *testing.T) {
+	items := make([]string, 10)
+	for i := range items {
+		items[i] = "x"
+	}
+
+	errMsg := errors.New("test error")
+	var callCount atomic.Int32
+
+	goroutinesBefore := runtime.NumGoroutine()
+
+	_, err := ProcessAll(context.Background(), items, 3, func(_ context.Context, _ string) (int, error) {
+		callCount.Add(1)
+		if callCount.Load() == 2 {
+			return 0, errMsg
+		}
+		return 1, nil
+	})
+
+	if err != errMsg {
+		t.Fatalf("expected error %v, got %v", errMsg, err)
+	}
+
+	// Give goroutines a moment to clean up
+	time.Sleep(100 * time.Millisecond)
+
+	goroutinesAfter := runtime.NumGoroutine()
+
+	if goroutinesAfter > goroutinesBefore {
+		t.Fatalf("goroutine leak detected: before=%d, after=%d", goroutinesBefore, goroutinesAfter)
+	}
+}
+
+// TestProcessAllNoGoroutineLeakOnCancel checks that goroutines don't leak
+// when context is cancelled.
+func TestProcessAllNoGoroutineLeakOnCancel(t *testing.T) {
+	items := make([]string, 10)
+	for i := range items {
+		items[i] = "x"
+	}
+
+	goroutinesBefore := runtime.NumGoroutine()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	var callCount atomic.Int32
+	var mu sync.Mutex
+	cancelled := false
+
+	_, err := ProcessAll(ctx, items, 3, func(ctx context.Context, _ string) (int, error) {
+		callCount.Add(1)
+		if callCount.Load() == 2 {
+			mu.Lock()
+			if !cancelled {
+				cancel()
+				cancelled = true
+			}
+			mu.Unlock()
+		}
+		// Check for cancellation
+		select {
+		case <-ctx.Done():
+			return 0, ctx.Err()
+		default:
+		}
+		return 1, nil
+	})
+
+	if err != context.Canceled {
+		t.Fatalf("expected context.Canceled, got %v", err)
+	}
+
+	// Give goroutines a moment to clean up
+	time.Sleep(500 * time.Millisecond)
+
+	goroutinesAfter := runtime.NumGoroutine()
+
+	if goroutinesAfter > goroutinesBefore {
+		t.Fatalf("goroutine leak detected: before=%d, after=%d", goroutinesBefore, goroutinesAfter)
+	}
+}
