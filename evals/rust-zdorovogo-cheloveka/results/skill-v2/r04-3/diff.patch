+/// Форматирует строку источника с уникальными сообщениями в порядке появления.
+/// Используется для уровней Critical и Warning.
+fn format_messages_line(source: &str, count: i64, entries: &[&Entry]) -> String {
+    let mut messages: Vec<&str> = Vec::new();
+    for entry in entries {
+        if !messages.contains(&entry.message.as_str()) {
+            messages.push(&entry.message);
+        }
+    }
+    format!("  {:<12} {:>5}  {}\n", source, count, messages.join("; "))
+}
+
+/// Форматирует строку источника с числом уникальных сообщений.
+/// Используется для уровня Info.
+fn format_count_line(source: &str, count: i64, entries: &[&Entry]) -> String {
+    let messages: BTreeSet<&str> = entries.iter().map(|e| e.message.as_str()).collect();
+    format!(
+        "  {:<12} {:>5}  ({} сообщ.)\n",
+        source,
+        count,
+        messages.len()
+    )
+}
+
+/// Форматирует секцию отчёта по уровню.
+fn format_section(
+    out: &mut String,
+    level: &Level,
+    map: &BTreeMap<&str, Vec<&Entry>>,
+    format_line: impl Fn(&str, i64, &[&Entry]) -> String,
+) {
+    if map.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+
+    for (source, list) in map {
+        let count: i64 = list.iter().map(|e| e.count).sum();
+        total += count;
+        out.push_str(&format_line(source, count, list));
+    }
+
+    out.push_str(&format!("  итого: {total}\n"));
+}
