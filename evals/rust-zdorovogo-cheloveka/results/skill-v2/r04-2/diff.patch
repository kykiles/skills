+/// Способ обработки сообщений в секции.
+enum MessageProcessing {
+    /// Выводить уникальные сообщения в порядке появления.
+    WithMessages,
+    /// Выводить только количество уникальных сообщений.
+    CountOnly,
+}
+
+/// Форматирует одну секцию отчёта.
+fn format_section(
+    section: &BTreeMap<&str, Vec<&Entry>>,
+    level: Level,
+    format: MessageProcessing,
+) -> String {
+    if section.is_empty() {
+        return String::new();
+    }
+
+    let mut out = String::new();
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+
+    for (source, list) in section {
+        let mut n = 0;
+
+        let messages_display = match format {
+            MessageProcessing::WithMessages => {
+                let mut messages: Vec<&str> = Vec::new();
+                for entry in list {
+                    n += entry.count;
+                    if !messages.contains(&entry.message.as_str()) {
+                        messages.push(&entry.message);
+                    }
+                }
+                messages.join("; ")
+            }
+            MessageProcessing::CountOnly => {
+                let mut messages: BTreeSet<&str> = BTreeSet::new();
+                for entry in list {
+                    n += entry.count;
+                    messages.insert(&entry.message);
+                }
+                format!("({} сообщ.)", messages.len())
+            }
+        };
+
+        total += n;
+        out.push_str(&format!(
+            "  {:<12} {:>5}  {}\n",
+            source, n, messages_display
+        ));
+    }
+
+    out.push_str(&format!("  итого: {total}\n"));
+    out
+}
