+/// Форматирует сообщения как список, разделённый "; ".
+/// Собирает уникальные сообщения в порядке появления.
+fn format_messages_list(entries: &[&Entry]) -> String {
+    let mut messages: Vec<&str> = Vec::new();
+    for entry in entries {
+        if !messages.contains(&entry.message.as_str()) {
+            messages.push(&entry.message);
+        }
+    }
+    messages.join("; ")
+}
+
+/// Форматирует сообщения как количество уникальных.
+/// Для Info-секции: "(N сообщ.)".
+fn format_messages_count(entries: &[&Entry]) -> String {
+    let mut messages: BTreeSet<&str> = BTreeSet::new();
+    for entry in entries {
+        messages.insert(&entry.message);
+    }
+    format!("({} сообщ.)", messages.len())
+}
+
+/// Форматирует секцию отчёта для одного уровня.
+/// `format_msg` — функция, которая форматирует часть сообщения в строке источника.
+fn format_section<F>(
+    out: &mut String,
+    level: Level,
+    entries_by_source: &BTreeMap<&str, Vec<&Entry>>,
+    format_msg: &F,
+) where
+    F: Fn(&[&Entry]) -> String,
+{
+    if entries_by_source.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+    for (source, list) in entries_by_source {
+        let mut n = 0;
+        for entry in list {
+            n += entry.count;
+        }
+        total += n;
+        let msg = format_msg(list);
+        out.push_str(&format!("  {:<12} {:>5}  {}\n", source, n, msg));
+    }
+    out.push_str(&format!("  итого: {total}\n"));
+}
