+/// Форматирует одну секцию отчёта (Critical, Warning или Info).
+/// `process_source` — функция для обработки каждого источника в секции,
+/// возвращает сумму count и форматированное содержимое для вывода.
+fn format_section<F>(
+    out: &mut String,
+    level: Level,
+    section_map: &BTreeMap<&str, Vec<&Entry>>,
+    mut process_source: F,
+) where
+    F: FnMut(&str, &[&Entry]) -> (i64, String),
+{
+    if section_map.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+    for (source, list) in section_map {
+        let (count, content) = process_source(source, list);
+        total += count;
+        out.push_str(&format!("  {:<12} {:>5}  {}\n", source, count, content));
+    }
+    out.push_str(&format!("  итого: {total}\n"));
+}
+
