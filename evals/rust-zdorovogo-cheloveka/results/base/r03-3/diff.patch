diff -ruN '--exclude=.git' '--exclude=target' '--exclude=Cargo.lock.bak' base_r03-enum/src/policy.rs ws/base/r03-3/src/policy.rs
--- base_r03-enum/src/policy.rs	2026-10-03 12:56:12.490947401 +0000
+++ ws/base/r03-3/src/policy.rs	2026-10-03 12:55:30.685960197 +0000
@@ -2,7 +2,7 @@
 
 /// Заказ ещё может перейти в другой статус.
 pub fn is_open(status: Status) -> bool {
-    !matches!(status, Status::Delivered | Status::Cancelled)
+    !matches!(status, Status::Delivered | Status::Cancelled | Status::Returned)
 }
 
 /// Покупатель может отменить заказ сам.
@@ -18,13 +18,14 @@
             | (Status::Paid, Status::Shipped)
             | (Status::Shipped, Status::Delivered)
             | (Status::New | Status::Paid, Status::Cancelled)
+            | (Status::Delivered, Status::Returned)
     )
 }
 
 /// Сколько копеек вернуть покупателю.
 pub fn refund(order: &Order) -> u64 {
     match order.status {
-        Status::Cancelled if order.total > 0 => order.total,
+        Status::Cancelled | Status::Returned if order.total > 0 => order.total,
         _ => 0,
     }
 }
@@ -42,4 +43,28 @@
         assert!(can_cancel(Status::Paid));
         assert!(!can_cancel(Status::Shipped));
     }
+
+    #[test]
+    fn returned_status() {
+        // Can only return from Delivered
+        assert!(can_move(Status::Delivered, Status::Returned));
+        assert!(!can_move(Status::Cancelled, Status::Returned));
+        assert!(!can_move(Status::New, Status::Returned));
+        assert!(!can_move(Status::Paid, Status::Returned));
+        assert!(!can_move(Status::Shipped, Status::Returned));
+
+        // Returned is a final state
+        assert!(!is_open(Status::Returned));
+
+        // Cannot manually cancel a returned order
+        assert!(!can_cancel(Status::Returned));
+
+        // Returned orders get full refund
+        let order = Order {
+            id: 1,
+            status: Status::Returned,
+            total: 50000,
+        };
+        assert_eq!(refund(&order), 50000);
+    }
 }
diff -ruN '--exclude=.git' '--exclude=target' '--exclude=Cargo.lock.bak' base_r03-enum/src/report.rs ws/base/r03-3/src/report.rs
--- base_r03-enum/src/report.rs	2026-10-03 12:56:12.490994631 +0000
+++ ws/base/r03-3/src/report.rs	2026-10-03 12:55:37.049960575 +0000
@@ -59,8 +59,31 @@
         ];
         assert_eq!(
             summary(&orders),
-            "новый: 0\nоплачен: 1\nв доставке: 0\nдоставлен: 1\nотменён: 1\n\
+            "новый: 0\nоплачен: 1\nв доставке: 0\nдоставлен: 1\nотменён: 1\nвозвращён: 0\n\
              открытых: 1, закрытых: 2\nвыручка: 1150.00 ₽\nвозвраты: 99.50 ₽\n"
         );
     }
+
+    #[test]
+    fn returned_orders_not_in_revenue() {
+        let orders = [
+            Order {
+                id: 1,
+                status: Status::Delivered,
+                total: 50000,
+            },
+            Order {
+                id: 2,
+                status: Status::Returned,
+                total: 50000,
+            },
+        ];
+        let summary_text = summary(&orders);
+        // Returned order should count in summary line
+        assert!(summary_text.contains("возвращён: 1"));
+        // Revenue should only count delivered, not returned
+        assert!(summary_text.contains("выручка: 500.00 ₽"));
+        // But should count as refund
+        assert!(summary_text.contains("возвраты: 500.00 ₽"));
+    }
 }
