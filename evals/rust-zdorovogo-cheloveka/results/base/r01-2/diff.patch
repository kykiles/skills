+
+    #[test]
+    fn rejects_invalid_port() {
+        let result = parse("port = 80o\n");
+        assert!(matches!(
+            result,
+            Err(ConfigError::InvalidValue { line: 1, .. })
+        ));
+        if let Err(ConfigError::InvalidValue {
+            line,
+            key,
+            value,
+            ..
+        }) = result
+        {
+            assert_eq!(line, 1);
+            assert_eq!(key, "port");
+            assert_eq!(value, "80o");
+        }
+    }
+
+    #[test]
+    fn rejects_invalid_timeout_ms() {
+        let result = parse("timeout_ms = abc\n");
+        assert!(matches!(
+            result,
+            Err(ConfigError::InvalidValue { line: 1, .. })
+        ));
+        if let Err(ConfigError::InvalidValue {
+            line,
+            key,
+            value,
+            ..
+        }) = result
+        {
+            assert_eq!(line, 1);
+            assert_eq!(key, "timeout_ms");
+            assert_eq!(value, "abc");
+        }
+    }
+
+    #[test]
