diff -ruN '--exclude=.git' '--exclude=target' '--exclude=Cargo.lock.bak' base_r03-enum/src/policy.rs ws/base/r03-2/src/policy.rs
--- base_r03-enum/src/policy.rs	2026-10-03 12:56:12.490947401 +0000
+++ ws/base/r03-2/src/policy.rs	2026-10-03 12:55:49.373961308 +0000
@@ -2,7 +2,7 @@
 
 /// Заказ ещё может перейти в другой статус.
 pub fn is_open(status: Status) -> bool {
-    !matches!(status, Status::Delivered | Status::Cancelled)
+    !matches!(status, Status::Delivered | Status::Cancelled | Status::Returned)
 }
 
 /// Покупатель может отменить заказ сам.
@@ -18,13 +18,14 @@
             | (Status::Paid, Status::Shipped)
             | (Status::Shipped, Status::Delivered)
             | (Status::New | Status::Paid, Status::Cancelled)
+            | (Status::Delivered, Status::Returned)
     )
 }
 
 /// Сколько копеек вернуть покупателю.
 pub fn refund(order: &Order) -> u64 {
     match order.status {
-        Status::Cancelled if order.total > 0 => order.total,
+        Status::Cancelled | Status::Returned if order.total > 0 => order.total,
         _ => 0,
     }
 }
@@ -41,5 +42,10 @@
         assert!(!is_open(Status::Cancelled));
         assert!(can_cancel(Status::Paid));
         assert!(!can_cancel(Status::Shipped));
+        // Returned статус
+        assert!(can_move(Status::Delivered, Status::Returned));
+        assert!(!can_move(Status::New, Status::Returned));
+        assert!(!is_open(Status::Returned));
+        assert!(!can_cancel(Status::Returned));
     }
 }
