+    #[test]
+    fn rejects_too_many_entries() {
+        // Archive with 65537 entries (exceeds 65536 limit)
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&65537u32.to_le_bytes());
+        // Don't add entries, just the invalid count
+        assert_eq!(
+            Archive::parse(&out).err(),
+            Some(Error::TooManyEntries)
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_offset() {
+        // Create archive with offset > u32::MAX (5 bytes of 0xFF to represent large u64)
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&1u32.to_le_bytes()); // 1 entry
+
+        // Offset that exceeds u32::MAX: 0x0000000100000000
+        let large_offset = 1u64 << 32;
+        out.extend_from_slice(&large_offset.to_le_bytes());
+        out.extend_from_slice(&0u32.to_le_bytes()); // len = 0
+        out.extend_from_slice(b"data");
+
+        assert_eq!(
+            Archive::parse(&out).err(),
+            Some(Error::InvalidOffset)
+        );
+    }
+
+    #[test]
+    fn rejects_overflow_in_offset_plus_len() {
+        // Create archive where offset + len would overflow usize
+        // With small archive and data: offset=u32::MAX, len=1 would overflow
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&1u32.to_le_bytes()); // 1 entry
+        out.extend_from_slice(&(u32::MAX as u64).to_le_bytes()); // offset = u32::MAX
+        out.extend_from_slice(&1u32.to_le_bytes()); // len = 1
+        out.extend_from_slice(b"x"); // minimal data
+
+        assert_eq!(
+            Archive::parse(&out).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn get_with_large_offsets() {
+        // Test that get() properly handles checked_add for large offsets
+        let input = archive(&[(0, 2), (2, 3)], b"hello");
+        let pak = Archive::parse(&input).unwrap();
+        assert_eq!(pak.get(0), Some(&b"he"[..]));
+        assert_eq!(pak.get(1), Some(&b"llo"[..]));
+    }
