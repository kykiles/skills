+#!/bin/bash
+set -e
+
+echo "=== Testing pak library security fixes ==="
+
+cd b
+
+echo ""
+echo "1. Testing overflow prevention in position calculation..."
+cargo test --offline rejects_overflow_in_offset_plus_len 2>&1 | grep -E "test.*ok|test.*PASS"
+
+echo ""
+echo "2. Testing OOM prevention (limiting entries to 65536)..."
+cargo test --offline rejects_too_many_entries 2>&1 | grep -E "test.*ok|test.*PASS"
+
+echo ""
+echo "3. Testing invalid offset rejection (> u32::MAX)..."
+cargo test --offline rejects_invalid_offset 2>&1 | grep -E "test.*ok|test.*PASS"
+
+echo ""
+echo "4. Testing correct data retrieval..."
+cargo test --offline reads_entries 2>&1 | grep -E "test.*ok|test.*PASS"
+
+echo ""
+echo "5. Running all tests..."
+cargo test --offline 2>&1 | tail -3
+
+echo ""
+echo "=== All security tests passed! ==="
