+    #[test]
+    fn rejects_too_many_records() {
+        // Create a header claiming 65537 records (more than MAX_RECORDS)
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&65537u32.to_le_bytes());
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::TooManyRecords)
+        );
+    }
+
+    #[test]
+    fn accepts_max_records() {
+        // Create a header with exactly MAX_RECORDS but no actual entries
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&65536u32.to_le_bytes());
+        // This should return Truncated since the table is missing
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_offset_overflow() {
+        // Create an archive with large offsets that would overflow
+        let input = archive(&[(u64::MAX, 1)], b"");
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn rejects_offset_plus_len_overflow() {
+        // Create an archive where offset + len overflows
+        let input = archive(&[(u64::MAX - 5, 10)], b"");
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn get_handles_large_offsets() {
