+    #[test]
+    fn rejects_too_many_entries() {
+        // Попытка создать архив с более чем 65536 записями должна быть отклонена
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&65537u32.to_le_bytes()); // 65537 записей
+        // Добавляем достаточно данных для таблицы (хотя они не будут все прочитаны)
+        input.extend_from_slice(&[0u8; 100]);
+
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::TooManyEntries)
+        );
+    }
+
+    #[test]
+    fn rejects_offset_overflow() {
+        // Попытка использовать очень большой offset, который переполняется при добавлении len
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&1u32.to_le_bytes()); // 1 запись
+        // offset = u64::MAX, len = 1 (переполнение при сложении)
+        input.extend_from_slice(&u64::MAX.to_le_bytes());
+        input.extend_from_slice(&1u32.to_le_bytes());
+        input.extend_from_slice(b"data");
+
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::InvalidOffset { index: 0 })
+        );
+    }
+
+    #[test]
+    fn rejects_position_overflow_in_table() {
+        // Попытка вызвать переполнение при чтении таблицы
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&u32::MAX.to_le_bytes()); // очень большое количество (но < 65536, поэтому не сработает)
+        // Это достаточно маленький файл, чтобы не соответствовать таблице
+
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::TooManyEntries) // Отклоняется на проверке 65536
+        );
+    }
+
+    #[test]
