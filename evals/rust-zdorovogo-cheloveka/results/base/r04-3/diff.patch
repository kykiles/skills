+    #[test]
+    fn message_order_and_deduplication() {
+        let got = format_report(
+            "test",
+            &[
+                entry("web", Level::Critical, "timeout", 1),
+                entry("web", Level::Critical, "error", 1),
+                entry("web", Level::Critical, "timeout", 1),
