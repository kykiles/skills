+/// Обрабатывает секцию с выводом сообщений (Critical, Warning).
+/// Сохраняет порядок появления первого сообщения.
+fn append_messages_section(
+    out: &mut String,
+    level: Level,
+    entries_by_source: &BTreeMap<&str, Vec<&Entry>>,
+) {
+    if entries_by_source.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+
+    for (source, list) in entries_by_source {
+        let mut count = 0;
+        let mut messages: Vec<&str> = Vec::new();
+
+        for entry in list {
+            count += entry.count;
+            if !messages.contains(&entry.message.as_str()) {
+                messages.push(&entry.message);
+            }
+        }
+
+        total += count;
+        out.push_str(&format!(
+            "  {:<12} {:>5}  {}\n",
+            source,
+            count,
+            messages.join("; ")
+        ));
+    }
+
+    out.push_str(&format!("  итого: {total}\n"));
+}
+
+/// Обрабатывает секцию Info: выводит только количество сообщений.
+fn append_count_section(
+    out: &mut String,
+    level: Level,
+    entries_by_source: &BTreeMap<&str, Vec<&Entry>>,
+) {
+    if entries_by_source.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+
+    for (source, list) in entries_by_source {
+        let mut count = 0;
+        let mut messages: BTreeSet<&str> = BTreeSet::new();
+
+        for entry in list {
+            count += entry.count;
+            messages.insert(&entry.message);
+        }
+
+        total += count;
+        out.push_str(&format!(
+            "  {:<12} {:>5}  ({} сообщ.)\n",
+            source,
+            count,
+            messages.len()
+        ));
+    }
+
+    out.push_str(&format!("  итого: {total}\n"));
+}
