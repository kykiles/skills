+                entry("db", Level::Warning, "slow", 1),
+                entry("api", Level::Info, "request", 1),
+                entry("api", Level::Info, "response", 1),
+                entry("api", Level::Info, "request", 1),
+            ],
+        );
+        // Check deduplication and order of appearance for Critical/Warning
