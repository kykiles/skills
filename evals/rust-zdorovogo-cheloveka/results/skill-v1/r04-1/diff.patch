+/// Форматирует одну секцию отчёта.
+///
+/// # Arguments
+///
+/// * `out` - строка для накопления результата
+/// * `level` - уровень секции
+/// * `sources` - map источников на список записей
+/// * `format_messages` - функция для форматирования сообщений (для Critical/Warning выводит сами сообщения,
+///   для Info — только их число)
+fn format_section<F>(
+    out: &mut String,
+    level: Level,
+    sources: &BTreeMap<&str, Vec<&Entry>>,
+    format_messages: F,
+) where
+    F: Fn(Vec<&str>) -> String,
+{
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+    for (source, list) in sources {
+        let mut n = 0;
+        let mut messages: BTreeSet<&str> = BTreeSet::new();
+        for entry in list {
+            n += entry.count;
+            messages.insert(&entry.message);
+        }
+        total += n;
+        let messages_formatted = format_messages(messages.iter().copied().collect());
+        out.push_str(&format!(
+            "  {:<12} {:>5}  {}\n",
+            source, n, messages_formatted
+        ));
+    }
+    out.push_str(&format!("  итого: {total}\n"));
+}
