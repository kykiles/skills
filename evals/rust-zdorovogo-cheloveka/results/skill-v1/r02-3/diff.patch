+    #[test]
+    fn rejects_too_many_records() {
+        // 65537 записей - больше максимума
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&65537u32.to_le_bytes());
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::TooManyRecords { count: 65537 })
+        );
+    }
+
+    #[test]
+    fn rejects_offset_overflow() {
+        // Смещение больше u32::MAX
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&1u32.to_le_bytes()); // 1 запись
+        let big_offset = u64::MAX;
+        input.extend_from_slice(&big_offset.to_le_bytes());
+        input.extend_from_slice(&1u32.to_le_bytes()); // len = 1
+                                                      // Должно быть Truncated, так как offset не помещается в u32
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_len_addition_overflow() {
+        // offset + len переполняется
+        let entries = vec![(u32::MAX as u64, 1)];
+        let input = archive(&entries, &[]);
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_get_with_overflow() {
+        // Архив где offset + len переполнится - должен быть отклонен при парсинге
+        let entries = vec![(u32::MAX as u64 - 1, 2)];
+        let input = archive(&entries, &[0, 1, 2]);
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn accepts_maximum_records() {
+        // Ровно 65536 записей - на границе лимита
+        let entries = vec![(0, 0); 65536];
+        let input = archive(&entries, &[]);
+        Archive::parse(&input).expect("должен принять ровно MAX_RECORDS");
+    }
