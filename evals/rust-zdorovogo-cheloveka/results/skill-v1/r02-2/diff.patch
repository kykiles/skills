+    #[test]
+    fn rejects_too_many_records() {
+        // Архив с 65537 записями должен быть отклонён (лимит 65536)
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&65537_u32.to_le_bytes());
+        assert_eq!(Archive::parse(&input).err(), Some(Error::TooManyRecords));
+    }
+
+    #[test]
+    fn rejects_offset_overflow() {
+        // Проверка переполнения: offset + len может переполниться
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&1_u32.to_le_bytes());
+        // offset = u32::MAX - 5, len = 10 (сумма переполнится)
+        input.extend_from_slice(&(u32::MAX as u64 - 5).to_le_bytes());
+        input.extend_from_slice(&10_u32.to_le_bytes());
+        input.extend_from_slice(b"data");
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn rejects_offset_too_large() {
+        // offset > u32::MAX должен быть отклонён
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&1_u32.to_le_bytes());
+        // offset = u64::MAX, len = 1
+        input.extend_from_slice(&u64::MAX.to_le_bytes());
+        input.extend_from_slice(&1_u32.to_le_bytes());
+        input.extend_from_slice(b"data");
+        assert_eq!(
+            Archive::parse(&input).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn rejects_huge_memory_request() {
+        // 12-байтный файл с заявлением о 100000 записей не должен вызывать OOM
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&100000_u32.to_le_bytes());
+        // Не читаем остальное - должна быть ошибка TooManyRecords перед выделением памяти
+        assert_eq!(Archive::parse(&input).err(), Some(Error::TooManyRecords));
+    }
