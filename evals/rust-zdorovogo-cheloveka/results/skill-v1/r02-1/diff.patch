+
+    #[test]
+    fn rejects_excessive_record_count() {
+        // Заголовок с count > MAX_RECORDS должен быть отклонён,
+        // даже если это всего 8 байт
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&(MAX_RECORDS as u32 + 1).to_le_bytes());
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_count_from_short_file() {
+        // 12-байтный файл с большим count должен вернуть Truncated,
+        // а не паниковать и не выделять гигабайты
+        let mut input = MAGIC.to_vec();
+        input.extend_from_slice(&u32::MAX.to_le_bytes());
+        assert_eq!(Archive::parse(&input).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_offset_overflow() {
+        // offset + len переполняется в u32 — должна быть ошибка
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&1u32.to_le_bytes());
+        // offset = u32::MAX, len = 1 → u32::MAX + 1 переполняется
+        out.extend_from_slice(&u32::MAX.to_le_bytes());
+        out.extend_from_slice(&1u32.to_le_bytes());
+        out.extend_from_slice(b"x");
+        assert_eq!(Archive::parse(&out).err(), Some(Error::Truncated));
+    }
+
+    #[test]
+    fn rejects_excessive_offset_for_data() {
+        // offset + len выходит за конец данных
+        let mut out = MAGIC.to_vec();
+        out.extend_from_slice(&1u32.to_le_bytes());
+        out.extend_from_slice(&100u64.to_le_bytes());
+        out.extend_from_slice(&50u32.to_le_bytes());
+        out.extend_from_slice(b"x");
+        assert_eq!(
+            Archive::parse(&out).err(),
+            Some(Error::OutOfBounds { index: 0 })
+        );
+    }
+
+    #[test]
+    fn get_with_overflow() {
+        // Если offset близко к u32::MAX, start + len может переполниться
+        // Это нельзя создать корректным архивом, но get() должен быть безопасен
+        let input = archive(&[(0, 5)], b"hello");
+        let pak = Archive::parse(&input).unwrap();
+        assert_eq!(pak.get(0), Some(&b"hello"[..]));
+    }
 }
