+/// Форматирует одну секцию отчёта (уровень, источники, сообщения).
+/// Функция `format_messages` преобразует список записей для источника в строку сообщений.
+fn format_section<F>(
+    out: &mut String,
+    level: Level,
+    section: &BTreeMap<&str, Vec<&Entry>>,
+    format_messages: F,
+) where
+    F: Fn(&[&Entry]) -> String,
+{
+    if section.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+    for (source, list) in section {
+        let n: i64 = list.iter().map(|entry| entry.count).sum();
+        let messages_str = format_messages(list);
+        total += n;
+        out.push_str(&format!("  {:<12} {:>5}  {}\n", source, n, messages_str));
+    }
+    out.push_str(&format!("  итого: {total}\n"));
+}
+
