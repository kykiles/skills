+/// Форматирует одну секцию отчёта для заданного уровня важности.
+fn format_section(out: &mut String, level: Level, section: &BTreeMap<&str, Vec<&Entry>>) {
+    if section.is_empty() {
+        return;
+    }
+
+    out.push_str(&format!("\n[{}]\n", level));
+    let mut total = 0;
+
+    for (source, list) in section {
+        let mut n = 0;
+        let line_suffix = match level {
+            Level::Critical | Level::Warning => {
+                // Для Critical и Warning выводим уникальные сообщения в порядке появления
+                let mut messages: Vec<&str> = Vec::new();
+                for entry in list {
+                    n += entry.count;
+                    if !messages.contains(&entry.message.as_str()) {
+                        messages.push(&entry.message);
+                    }
+                }
+                messages.join("; ")
+            }
+            Level::Info => {
+                // Для Info выводим только количество уникальных сообщений
+                let mut messages: BTreeSet<&str> = BTreeSet::new();
+                for entry in list {
+                    n += entry.count;
+                    messages.insert(&entry.message);
+                }
+                format!("({} сообщ.)", messages.len())
+            }
+        };
+        total += n;
+
+        out.push_str(&format!("  {:<12} {:>5}  {}\n", source, n, line_suffix));
+    }
+
+    out.push_str(&format!("  итого: {total}\n"));
+}
